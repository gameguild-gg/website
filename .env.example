# Healthcheck Configuration
HEALTHCHECK_START_INTERVAL=45s
HEALTHCHECK_START_PERIOD=60s
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3

# Database Configuration

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_CONTAINER_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_TIMEZONE=UTC
# Required by Coolify startup initialization. The username must differ from POSTGRES_USER.
# Before the first migration, run apps/api/scripts/bootstrap-economy-database.sql
# as a PostgreSQL administrator with: psql -v migration_role=<role> -d <database> -f <script>
POSTGRES_MIGRATION_CONNECTION=Host=localhost;Port=5432;Database=your_database_name;Username=your_database_migration_user;Password=your_database_migration_password
DATABASE_GRANT_RUNTIME_ROLE_AFTER_MIGRATIONS=true
DATABASE_FAIL_STARTUP_ON_MIGRATION_FAILURE=false
DATABASE_FAIL_STARTUP_ON_SEED_FAILURE=false
DATABASE_FAIL_STARTUP_ON_GRANT_FAILURE=false
# PostgreSQL SSL Configuration
POSTGRES_SSL_CA="-----BEGIN RSA PRIVATE KEY-----\n\n-----END RSA PRIVATE KEY-----"
POSTGRES_SSL_CERT="-----BEGIN RSA PRIVATE KEY-----\n\n-----END RSA PRIVATE KEY-----"
POSTGRES_SSL_KEY="-----BEGIN RSA PRIVATE KEY-----\n\n-----END RSA PRIVATE KEY-----"
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Environment Configuration

# ASP.NET Core Environment Configuration
ASPNETCORE_ENVIRONMENT=Development
# Node.js Environment Configuration
NODE_ENV=Development

# Applications Configuration

# API Configuration
API_HOST=localhost
API_PORT=7000
API_DOMAIN=api.example.com
API_INTERNAL_URL=http://api:8080
API_PUBLIC_URL=https://api.example.com

# Auth / crypto used by API, web, and learning deployments.
# Generate production values with at least 32 characters.
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG
JWT_ISSUER=GameGuild
JWT_AUDIENCE=GameGuild.Users
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_ENCRYPTION_KEY_AT_LEAST_32_CHARACTERS_LONG
AUTH_SECRET=CHANGE_THIS_TO_A_SECURE_AUTH_SECRET_AT_LEAST_32_CHARACTERS_LONG

# Shared Redis
REDIS_ENABLED=true
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=game-guild:

# Object Storage Configuration (S3-compatible / Garage)
S3_SERVICE_URL=http://localhost:3900
S3_CONTAINER_SERVICE_URL=http://garage:3900
S3_ACCESS_KEY=GK111111111111111111111111
S3_SECRET_KEY=2222222222222222222222222222222222222222222222222222222222222222
ASSET_TOKEN_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
S3_REGION=garage
S3_BUCKET=gameguild-assets
S3_BUCKET_TRANSFORMED=
S3_BUCKET_QUARANTINE=
S3_PRESIGNED_EXPIRY=60

# Monthly Statement Email Delivery
STATEMENTEMAILS__CONSOLEBASEURL=http://localhost:3000
EMAILDELIVERY__ENABLED=true
EMAILDELIVERY__PROVIDER=Smtp
EMAILDELIVERY__FROMEMAIL=no-reply@example.com
EMAILDELIVERY__FROMNAME=GameGuild
EMAILDELIVERY__SMTPHOST=mailhog
EMAILDELIVERY__SMTPPORT=1025
EMAILDELIVERY__SMTPUSERNAME=
EMAILDELIVERY__SMTPPASSWORD=
EMAILDELIVERY__SMTPUSESSL=false

# Override these in production when SendGrid is available.
# EMAILDELIVERY__PROVIDER=SendGrid
# EMAILDELIVERY__SENDGRIDAPIKEY=your_sendgrid_api_key

# Google OAuth (One Tap + backend audience validation).
# 3-way equality REQUIRED: GOOGLE_CLIENT_ID == NEXT_PUBLIC_GOOGLE_CLIENT_ID == OAuth__Google__ClientId
# (same Google OAuth client id). Mismatch → backend audience validation rejects all tokens.
#
# For Docker: compose.yaml maps GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET to
# OAuth__Google__ClientId/OAuth__Google__ClientSecret automatically.
#
# For local dev (dotnet run): the dev:api script uses dotenv-cli to load
# this .env file, so OAuth__Google__ClientId and OAuth__Google__ClientSecret
# are set automatically.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#NEXT_PUBLIC_GOOGLE_CLIENT_ID=
#OAuth__Google__ClientId=
#OAuth__Google__ClientSecret=

# Discord OAuth (classic redirect flow; server-side only — no NEXT_PUBLIC variable).
#
# For Docker: compose.yaml maps DISCORD_CLIENT_ID/DISCORD_CLIENT_SECRET to
# OAuth__Discord__ClientId/OAuth__Discord__ClientSecret automatically.
#
# For local dev (dotnet run): the dev:api script uses dotenv-cli to load
# this .env file, so OAuth__Discord__ClientId and OAuth__Discord__ClientSecret
# are set automatically.
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
#OAuth__Discord__ClientId=
#OAuth__Discord__ClientSecret=

# Canonical ASP.NET Core Stripe configuration used by the Payments and Billing modules.
# Use test-mode values in Staging and live-mode values in Production.
PaymentGateways__Stripe__ApiKey=sk_test_CHANGE_THIS
PaymentGateways__Stripe__PublishableKey=pk_test_CHANGE_THIS
Billing__Stripe__WebhookSecret=whsec_CHANGE_THIS
Billing__Stripe__WebhookEndpointId=we_CHANGE_THIS
Billing__Stripe__ApiVersion=SET_TO_THE_STRIPE_API_VERSION_CONFIGURED_FOR_THE_ENDPOINT
Billing__Stripe__ConnectedAccountId=
Billing__Stripe__LiveMode=false
Billing__Stripe__WebhookToleranceSeconds=300

# Learning Management System (LMS) Configuration
ACADEMY_HOST=localhost
ACADEMY_PORT=6000
ACADEMY_DOMAIN=academy.example.com
LEARNING_PUBLIC_URL=https://learning.example.com
AUTH_COOKIE_DOMAIN=.example.com

# Blog Configuration
BLOG_HOST=localhost
BLOG_PORT=5000
BLOG_DOMAIN=blog.example.com

# Console Configuration
CONSOLE_HOST=localhost
CONSOLE_PORT=4000
CONSOLE_DOMAIN=console.example.com

# Website Configuration
WEBSITE_HOST=localhost
WEBSITE_PORT=3000
WEBSITE_DOMAIN=www.example.com
WEB_PUBLIC_URL=https://www.example.com
