    ProgramEnrollmentId [name: "IX_content_progress_ProgramEnrollmentId"]
    UserId [name: "IX_content_progress_UserId"]
    (UserId, ContentId) [unique, name: "IX_content_progress_UserId_ContentId"]
  }
}

