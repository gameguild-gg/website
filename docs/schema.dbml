Table "billing_webhook_events" {
  "Id" uuid [not null]
  "Provider" "character varying(50)" [not null]
  "ExternalEventId" "character varying(255)" [not null]
  "ProviderEnvironment" "character varying(32)"
  "ProviderAccountId" "character varying(255)"
  "WebhookEndpointId" "character varying(255)"
  "ProviderObjectId" "character varying(255)"
  "ProviderObjectType" "character varying(100)"
  "ProviderMonetaryLeg" "character varying(100)"
  "IsLiveMode" boolean
  "EventSchemaVersion" "character varying(50)"
  "EventType" "character varying(100)" [not null]
  "Payload" text [not null]
  "Headers" text
  "IsProcessed" boolean [not null]
  "IsFailed" boolean [not null]
  "ProcessingAttempts" integer [not null]
  "ErrorMessage" "character varying(2000)"
  "ProcessedAt" timestamp
  "TenantId" uuid
  "SubscriptionId" uuid
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp

  Checks {
    `("ProviderEnvironment" IS NULL OR ("ProviderEnvironment" = 'live' AND "IsLiveMode" = true) OR ("ProviderEnvironment" = 'test' AND "IsLiveMode" = false))` [name: 'ck_billing_webhook_events_provider_environment']
    `(("ProviderObjectId" IS NULL AND "ProviderObjectType" IS NULL AND "ProviderMonetaryLeg" IS NULL) OR ("ProviderObjectId" IS NOT NULL AND "ProviderObjectType" IS NOT NULL AND "ProviderMonetaryLeg" IS NOT NULL AND "ProviderEnvironment" IS NOT NULL AND "ProviderAccountId" IS NOT NULL))` [name: 'ck_billing_webhook_events_provider_object_complete']
    `(("ProviderEnvironment" IS NULL AND "ProviderAccountId" IS NULL AND "WebhookEndpointId" IS NULL AND "IsLiveMode" IS NULL) OR ("ProviderEnvironment" IS NOT NULL AND "ProviderAccountId" IS NOT NULL AND "WebhookEndpointId" IS NOT NULL AND "IsLiveMode" IS NOT NULL))` [name: 'ck_billing_webhook_events_provider_scope_complete']
  }

  Indexes {
    Id [pk, name: "PK_billing_webhook_events"]
    CreatedAt [name: "ix_billing_webhook_events_created_at"]
    EventType [name: "ix_billing_webhook_events_event_type"]
    (ExternalEventId, Provider) [unique, name: "ix_billing_webhook_events_external_id_provider"]
    IsFailed [name: "ix_billing_webhook_events_is_failed"]
    IsProcessed [name: "ix_billing_webhook_events_is_processed"]
    (Provider, ProviderEnvironment, ProviderAccountId, ProviderObjectId, ProviderMonetaryLeg) [name: "ix_billing_webhook_events_provider_object_leg"]
    (Provider, ProviderEnvironment, ProviderAccountId, WebhookEndpointId, ExternalEventId) [unique, name: "ix_billing_webhook_events_provider_scope_event"]
    SubscriptionId [name: "ix_billing_webhook_events_subscription_id"]
    TenantId [name: "ix_billing_webhook_events_tenant_id"]
  }
}

