  "UpdatedAt" timestamp [not null]

  Checks {
    `"CumulativeProviderUnits" >= 0 AND "ReversedUnits" >= 0 AND "ReversedUnits" <= "CumulativeProviderUnits"` [name: 'ck_economy_root_reversal_states_cumulative_bounds']
    `"Epoch" >= 0` [name: 'ck_economy_root_reversal_states_epoch_nonnegative']
  }

  Indexes {
    RootSourceStampId [pk, name: "PK_economy_root_reversal_states"]
    (RootSourceStampId, Epoch) [unique, name: "ux_economy_root_reversal_states_root_epoch"]
  }
}

