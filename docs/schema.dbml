Table "economy_source_stamps" {
  "Id" uuid [not null]
  "SourceKind" "character varying(100)" [not null]
  "InternalSourceId" "character varying(256)" [not null]
  "SourceLegId" "character varying(256)" [not null]
  "Provider" "character varying(100)"
  "ProviderReference" "character varying(256)"
