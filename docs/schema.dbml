  Checks {
    `"RequestHash" ~ '^[0-9a-f]{64}$'` [name: 'CK_GradingCommandReceipts_Hash']
    `octet_length("OutcomeCanonicalJson") <= 1048576` [name: 'CK_GradingCommandReceipts_OutcomeSize']
    `"ExpiresAt" > "CreatedAt"` [name: 'CK_GradingCommandReceipts_Retention']
  }

  Indexes {
    Id [pk, name: "PK_GradingCommandReceipts"]
    (TenantId, ResourceId, CommandType, ActorId, IdempotencyKey) [unique, name: "IX_GradingCommandReceipts_TenantId_ResourceId_CommandType_Acto~"]
  }
}

