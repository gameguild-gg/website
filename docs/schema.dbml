Table "AssessmentContentCompletionProjections" {
  "Id" uuid [not null]
  "AssessmentId" uuid [not null]
  "ContentId" uuid [not null]
  "EnrollmentId" uuid [not null]
  "SubmissionId" uuid [not null]
  "GradeRoundId" uuid
  "Transition" "character varying(32)" [not null]
  "CompletedAt" timestamp [not null]
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `"Transition" IN ('submit', 'finalize', 'release', 'release-and-pass')` [name: 'CK_AssessmentContentCompletionProjections_Transition']
  }

  Indexes {
    Id [pk, name: "PK_AssessmentContentCompletionProjections"]
    (AssessmentId, ContentId, EnrollmentId) [unique, name: "IX_AssessmentContentCompletionProjections_AssessmentId_Content~"]
    GradeRoundId [name: "IX_AssessmentContentCompletionProjections_GradeRoundId"]
    SubmissionId [name: "IX_AssessmentContentCompletionProjections_SubmissionId"]
  }
}

Table "AssessmentGradebookEntries" {
  "Id" uuid [not null]
  "CourseId" uuid [not null]
  "EnrollmentId" uuid [not null]
  "AssessmentId" uuid [not null]
  "AssessmentGroupId" uuid
  "SubmissionId" uuid [not null]
  "GradeRoundId" uuid [not null]
  "EffectiveScore" integer [not null]
  "CapturedMaxScore" integer [not null]
  "CapturedWeightPercent" integer
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `"EffectiveScore" >= 0 AND "CapturedMaxScore" > 0 AND "EffectiveScore" <= "CapturedMaxScore"` [name: 'CK_AssessmentGradebookEntries_Score']
    `"CapturedWeightPercent" IS NULL OR ("CapturedWeightPercent" >= 0 AND "CapturedWeightPercent" <= 10000)` [name: 'CK_AssessmentGradebookEntries_Weight']
  }

  Indexes {
    Id [pk, name: "PK_AssessmentGradebookEntries"]
    AssessmentGroupId [name: "IX_AssessmentGradebookEntries_AssessmentGroupId"]
    AssessmentId [name: "IX_AssessmentGradebookEntries_AssessmentId"]
    (CourseId, EnrollmentId) [name: "IX_AssessmentGradebookEntries_CourseId_EnrollmentId"]
    (EnrollmentId, AssessmentId) [unique, name: "IX_AssessmentGradebookEntries_EnrollmentId_AssessmentId"]
    GradeRoundId [name: "IX_AssessmentGradebookEntries_GradeRoundId"]
    SubmissionId [name: "IX_AssessmentGradebookEntries_SubmissionId"]
  }
}

Table "GradeItemResults" {
  "Id" uuid [not null]
  "TenantId" uuid
  "ReviewStageId" uuid [not null]
  "ItemId" "character varying(200)" [not null]
  "State" "character varying(32)" [not null]
  "Score" integer
  "MaxScore" integer [not null]
  "Feedback" text
  "CreatedAt" timestamp [not null]

  Checks {
    `"MaxScore" >= 0 AND ("Score" IS NULL OR ("Score" >= 0 AND "Score" <= "MaxScore")) AND (("State" = 'graded') = ("Score" IS NOT NULL))` [name: 'CK_GradeItemResults_ScoreRange']
    `"State" IN ('graded', 'pending', 'unsupported')` [name: 'CK_GradeItemResults_State']
  }

  Indexes {
    Id [pk, name: "PK_GradeItemResults"]
    (ReviewStageId, ItemId) [unique, name: "IX_GradeItemResults_ReviewStageId_ItemId"]
  }
}

Table "GradeResultReleases" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "GradeRoundId" uuid [not null]
  "GradingExecutionId" uuid [not null]
  "ExecutionContext" "character varying(32)" [not null]
  "Status" "character varying(16)" [not null]
  "ReleasedByActorId" uuid
  "ReleasedByService" "character varying(160)"
  "Reason" text
  "ReleasedAt" timestamp [not null]

  Checks {
    `"ExecutionContext" = 'official-submission'` [name: 'CK_GradeResultReleases_OfficialExecution']
    `num_nonnulls("ReleasedByActorId", "ReleasedByService") = 1` [name: 'CK_GradeResultReleases_Producer']
    `"Status" = 'released'` [name: 'CK_GradeResultReleases_Status']
  }

  Indexes {
    Id [pk, name: "PK_GradeResultReleases"]
    GradeRoundId [unique, name: "IX_GradeResultReleases_GradeRoundId"]
    (GradeRoundId, GradingExecutionId) [name: "IX_GradeResultReleases_GradeRoundId_GradingExecutionId"]
    (GradingExecutionId, ExecutionContext) [name: "IX_GradeResultReleases_GradingExecutionId_ExecutionContext"]
  }
}

Table "GradeRounds" {
  "Id" uuid [not null]
  "GradingExecutionId" uuid [not null]
  "RoundNumber" integer [not null]
  "SupersedesGradeRoundId" uuid
  "Reason" "character varying(64)" [not null]
  "ReasonDetail" text
  "InitiatedByActorId" uuid
  "Status" "character varying(48)" [not null]
  "ResultSchemaVersion" integer [not null]
  "ResultState" text
  "Score" integer
  "MaxScore" integer [not null]
  "Feedback" text
  "StartedAt" timestamp [not null]
  "FinalizedAt" timestamp
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `("Status" = 'finalized') = ("FinalizedAt" IS NOT NULL)` [name: 'CK_GradeRounds_Finalization']
    `"RoundNumber" > 0` [name: 'CK_GradeRounds_Number']
    `"Reason" IN ('initial', 'regrade')` [name: 'CK_GradeRounds_Reason']
    `("ResultState" IS NULL AND "Score" IS NULL) OR ("ResultState" = 'partial' AND "Score" IS NULL) OR ("ResultState" = 'final' AND "Score" IS NOT NULL)` [name: 'CK_GradeRounds_Result']
    `"ResultSchemaVersion" = 1` [name: 'CK_GradeRounds_ResultSchema']
    `"MaxScore" > 0 AND ("Score" IS NULL OR ("Score" >= 0 AND "Score" <= "MaxScore"))` [name: 'CK_GradeRounds_ScoreRange']
    `"Status" IN ('pending', 'running', 'awaiting-evidence', 'awaiting-instructor-resolution', 'failed', 'finalized')` [name: 'CK_GradeRounds_Status']
  }

  Indexes {
    Id [pk, name: "PK_GradeRounds"]
    (Id, GradingExecutionId) [unique, name: "AK_GradeRounds_Id_GradingExecutionId"]
    (GradingExecutionId, RoundNumber) [unique, name: "IX_GradeRounds_GradingExecutionId_RoundNumber"]
    (SupersedesGradeRoundId, GradingExecutionId) [name: "IX_GradeRounds_SupersedesGradeRoundId_GradingExecutionId"]
  }
}

Table "GradingExecutions" {
  "Id" uuid [not null]
  "DefinitionRevisionId" uuid [not null]
  "ExecutionContext" "character varying(32)" [not null]
  "TestRunSubjectId" uuid
  "AssessmentSubmissionId" uuid
  "DeliverySchemaVersion" "character varying(32)"
  "DeliveryCanonicalJson" text
  "DeliveryHash" character(64)
  "DeliveryHashVersion" "character varying(32)"
  "ResponseSchemaVersion" "character varying(32)"
  "ResponseContentType" "character varying(128)"
  "ResponsePayloadSchema" "character varying(160)"
  "ResponseEnvelopeCanonicalJson" text
  "ResponseHash" character(64)
  "ResponseHashVersion" "character varying(32)"
  "Status" "character varying(48)" [not null]
  "ActiveGradeRoundId" uuid
  "SubmittedAt" timestamp
  "FinalizedAt" timestamp
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `num_nonnulls("DeliverySchemaVersion", "DeliveryCanonicalJson", "DeliveryHash", "DeliveryHashVersion") IN (0, 4)` [name: 'CK_GradingExecutions_DeliveryAllOrNone']
    `"DeliveryCanonicalJson" IS NULL OR octet_length("DeliveryCanonicalJson") <= 8388608` [name: 'CK_GradingExecutions_DeliverySize']
    `("Status" IN ('completed', 'failed')) = ("FinalizedAt" IS NOT NULL)` [name: 'CK_GradingExecutions_Finalization']
    `("DeliveryHash" IS NULL OR "DeliveryHash" ~ '^[0-9a-f]{64}$') AND ("ResponseHash" IS NULL OR "ResponseHash" ~ '^[0-9a-f]{64}$')` [name: 'CK_GradingExecutions_Hashes']
    `("DeliveryHashVersion" IS NULL OR "DeliveryHashVersion" = 'sha256-jcs-v1') AND ("ResponseHashVersion" IS NULL OR "ResponseHashVersion" = 'sha256-jcs-v1')` [name: 'CK_GradingExecutions_HashVersions']
    `("ExecutionContext" = 'author-test' AND "TestRunSubjectId" IS NOT NULL AND "AssessmentSubmissionId" IS NULL) OR ("ExecutionContext" = 'official-submission' AND "TestRunSubjectId" IS NULL AND "AssessmentSubmissionId" IS NOT NULL)` [name: 'CK_GradingExecutions_Owner']
    `num_nonnulls("ResponseSchemaVersion", "ResponseContentType", "ResponsePayloadSchema", "ResponseEnvelopeCanonicalJson", "ResponseHash", "ResponseHashVersion") IN (0, 6)` [name: 'CK_GradingExecutions_ResponseAllOrNone']
    `"ResponseEnvelopeCanonicalJson" IS NULL OR octet_length("ResponseEnvelopeCanonicalJson") <= 8388608` [name: 'CK_GradingExecutions_ResponseSize']
    `"Status" IN ('pending', 'running', 'awaiting-review', 'completed', 'failed')` [name: 'CK_GradingExecutions_Status']
    `("Status" = 'pending' AND "SubmittedAt" IS NULL) OR ("Status" <> 'pending' AND "SubmittedAt" IS NOT NULL)` [name: 'CK_GradingExecutions_SubmissionLifecycle']
  }

  Indexes {
    Id [pk, name: "PK_GradingExecutions"]
    (Id, ExecutionContext) [unique, name: "AK_GradingExecutions_Id_ExecutionContext"]
    (ActiveGradeRoundId, Id) [name: "IX_GradingExecutions_ActiveGradeRoundId_Id"]
    AssessmentSubmissionId [unique, name: "IX_GradingExecutions_AssessmentSubmissionId"]
    DefinitionRevisionId [name: "IX_GradingExecutions_DefinitionRevisionId"]
    TestRunSubjectId [name: "IX_GradingExecutions_TestRunSubjectId"]
  }
}

Table "ReviewStages" {
  "Id" uuid [not null]
  "GradeRoundId" uuid [not null]
  "Sequence" integer [not null]
  "ReviewMethod" "character varying(32)" [not null]
  "HandlerKey" "character varying(128)" [not null]
  "HandlerVersion" "character varying(64)" [not null]
  "ProviderKey" "character varying(128)"
  "ProviderPolicyVersion" "character varying(64)"
  "Status" "character varying(48)" [not null]
  "StartedAt" timestamp
  "CompletedAt" timestamp
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `("Status" IN ('completed', 'failed')) = ("CompletedAt" IS NOT NULL) AND ("StartedAt" IS NULL OR "CompletedAt" IS NULL OR "StartedAt" <= "CompletedAt")` [name: 'CK_ReviewStages_Lifecycle']
    `"ReviewMethod" IN ('peer-review', 'ai-review', 'automated-review', 'instructor-review', 'self-review')` [name: 'CK_ReviewStages_Method']
    `num_nonnulls("ProviderKey", "ProviderPolicyVersion") IN (0, 2)` [name: 'CK_ReviewStages_ProviderBinding']
    `"Sequence" > 0` [name: 'CK_ReviewStages_Sequence']
    `"Status" IN ('pending', 'running', 'awaiting-evidence', 'awaiting-instructor-resolution', 'completed', 'failed')` [name: 'CK_ReviewStages_Status']
  }

  Indexes {
    Id [pk, name: "PK_ReviewStages"]
    (GradeRoundId, Sequence) [unique, name: "IX_ReviewStages_GradeRoundId_Sequence"]
  }
}

Table "ReviewEvidence" {
  "Id" uuid [not null]
  "TenantId" uuid
  "ReviewStageId" uuid [not null]
  "EvidenceKey" "character varying(160)" [not null]
  "ItemId" "character varying(200)"
  "EvidenceType" "character varying(128)" [not null]
  "SchemaVersion" "character varying(64)" [not null]
  "CanonicalJson" text [not null]
  "PayloadHash" character(64) [not null]
  "HashVersion" "character varying(32)" [not null]
  "ProducedByActorId" uuid
  "ProducedByService" "character varying(160)"
  "CreatedAt" timestamp [not null]

  Checks {
    `"PayloadHash" ~ '^[0-9a-f]{64}$'` [name: 'CK_ReviewEvidence_Hash']
    `"HashVersion" = 'sha256-jcs-v1'` [name: 'CK_ReviewEvidence_HashVersion']
    `num_nonnulls("ProducedByActorId", "ProducedByService") = 1` [name: 'CK_ReviewEvidence_Producer']
    `octet_length("CanonicalJson") <= 1048576` [name: 'CK_ReviewEvidence_Size']
  }

  Indexes {
    Id [pk, name: "PK_ReviewEvidence"]
    (ReviewStageId, EvidenceKey) [unique, name: "IX_ReviewEvidence_ReviewStageId_EvidenceKey"]
  }
}

