  "ConfirmedAt" timestamp
  "LastError" text

  Checks {
    `"AttemptCount" >= 0` [name: 'CK_AcademicOutboxDeliveries_Attempts']
    `"LastError" IS NULL OR octet_length("LastError") <= 4096` [name: 'CK_AcademicOutboxDeliveries_ErrorSize']
    `("Status" = 'processing') = ("ClaimedAt" IS NOT NULL AND "ClaimedBy" IS NOT NULL) AND ("Status" = 'confirmed') = ("ConfirmedAt" IS NOT NULL) AND ("Status" = 'failed') = ("NextAttemptAt" IS NOT NULL)` [name: 'CK_AcademicOutboxDeliveries_Lifecycle']
    `"Status" IN ('pending', 'processing', 'confirmed', 'failed')` [name: 'CK_AcademicOutboxDeliveries_Status']
  }

  Indexes {
    Id [pk, name: "PK_AcademicOutboxDeliveries"]
    (OutboxMessageId, ConsumerKey) [unique, name: "IX_AcademicOutboxDeliveries_OutboxMessageId_ConsumerKey"]
    (Status, ClaimedAt) [name: "IX_AcademicOutboxDeliveries_Status_ClaimedAt"]
    (Status, NextAttemptAt) [name: "IX_AcademicOutboxDeliveries_Status_NextAttemptAt"]
  }
}

