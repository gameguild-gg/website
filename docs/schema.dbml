Table "economy_legacy_shadow_batches" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "RequestedBy" uuid [not null]
  "JurisdictionCode" "character varying(16)" [not null]
  "PolicyVersion" bigint [not null]
  "State" integer [not null]
  "WalletCount" integer [not null]
  "TransactionCount" integer [not null]
  "FinancialLedgerEntryCount" integer [not null]
  "ExpectedHardUnits" bigint [not null]
  "BackfilledHardUnits" bigint [not null]
  "ReconciledHardUnits" bigint [not null]
  "WalletSnapshotHash" "character varying(128)" [not null]
  "TransactionSnapshotHash" "character varying(128)" [not null]
  "FinancialLedgerSnapshotHash" "character varying(128)" [not null]
  "RequestHash" "character varying(128)" [not null]
  "FailureCode" "character varying(128)"
  "CapturedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "Version" bigint [not null]

  Checks {
    `"WalletCount" >= 0 AND "TransactionCount" >= 0 AND "FinancialLedgerEntryCount" >= 0` [name: 'ck_economy_legacy_shadow_batches_counts']
    `"State" BETWEEN 1 AND 8` [name: 'ck_economy_legacy_shadow_batches_state']
    `"ExpectedHardUnits" >= 0 AND "BackfilledHardUnits" >= 0 AND "ReconciledHardUnits" >= 0` [name: 'ck_economy_legacy_shadow_batches_units']
    `"Version" > 0` [name: 'ck_economy_legacy_shadow_batches_version']
  }

  Indexes {
    Id [pk, name: "PK_economy_legacy_shadow_batches"]
    RequestHash [unique, name: "IX_economy_legacy_shadow_batches_RequestHash"]
    (TenantId, State) [name: "IX_economy_legacy_shadow_batches_TenantId_State"]
  }
}

Table "economy_marketplace_currency_policy_versions" {
  "TenantId" uuid [not null]
  "ProductId" uuid [not null]
  "Version" bigint [not null]
  "SellerId" uuid [not null]
  "Mode" integer [not null]
  "HardPriceUnits" bigint [not null]
  "SoftPriceUnits" bigint [not null]
  "PlatformFeePpm" integer [not null]
  "EffectiveAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "PlatformFeeWalletId" uuid [not null]
  "RefundHoldTicks" bigint [not null]
  "CanonicalPayload" text [not null]
  "PayloadHash" "character varying(128)" [not null]
  "KeyId" "character varying(256)" [not null]
  "Signature" text [not null]
  "ProposedBy" uuid [not null]
  "ApprovedBy" uuid [not null]
  "PublishedAt" timestamp [not null]

  Checks {
    `"ProposedBy" <> "ApprovedBy"` [name: 'ck_economy_marketplace_currency_policy_versions_dual_control']
    `"PlatformFeePpm" BETWEEN 0 AND 999999` [name: 'ck_economy_marketplace_currency_policy_versions_fee']
    `("Mode" = 1 AND "HardPriceUnits" > 0 AND "SoftPriceUnits" = 0) OR ("Mode" = 2 AND "HardPriceUnits" = 0 AND "SoftPriceUnits" > 0) OR ("Mode" IN (3, 4) AND "HardPriceUnits" > 0 AND "SoftPriceUnits" > 0)` [name: 'ck_economy_marketplace_currency_policy_versions_prices']
    `"Version" > 0` [name: 'ck_economy_marketplace_currency_policy_versions_version']
    `"ExpiresAt" > "EffectiveAt" AND "RefundHoldTicks" > 0` [name: 'ck_economy_marketplace_currency_policy_versions_window']
  }

  Indexes {
    (TenantId, ProductId, Version) [pk, name: "PK_economy_marketplace_currency_policy_versions"]
    (TenantId, ProductId, EffectiveAt, ExpiresAt) [name: "IX_economy_marketplace_currency_policy_versions_TenantId_Produ~"]
  }
}

Table "economy_marketplace_settlements" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "OrderId" uuid [not null]
  "OrderLineItemId" uuid [not null]
  "ProductId" uuid [not null]
  "ProductPricingVersionId" uuid [not null]
  "PriceVersionSnapshot" integer [not null]
  "Quantity" integer [not null]
  "RefundedQuantity" integer [not null]
  "UnitPriceSnapshot" numeric [not null]
  "FiatCurrencySnapshot" "character varying(3)" [not null]
  "OrderSnapshotHash" "character varying(128)" [not null]
  "BuyerId" uuid [not null]
  "BuyerWalletId" uuid [not null]
  "SellerId" uuid [not null]
  "SellerWalletId" uuid [not null]
  "PlatformFeeWalletId" uuid [not null]
  "PolicyVersion" bigint [not null]
  "CurrencyMode" integer [not null]
  "Status" integer [not null]
  "IdempotencyKey" "character varying(256)" [not null]
  "EntitlementId" uuid [not null]
  "EntitlementStatus" integer [not null]
  "PostingId" uuid [not null]
  "JournalSequence" bigint [not null]
  "JournalHash" "character varying(128)" [not null]
  "CapabilityReceiptId" uuid [not null]
  "CapabilityReceiptHash" "character varying(128)" [not null]
  "ReserveVersion" bigint [not null]
  "RiskDecisionId" uuid [not null]
  "KillSwitchEpoch" bigint [not null]
  "JurisdictionCode" "character varying(16)" [not null]
  "EvidenceHashes" jsonb [not null]
  "RefundHoldUntil" timestamp [not null]
  "SettledAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "Version" bigint [not null]

  Checks {
    `"RefundHoldUntil" > "SettledAt"` [name: 'ck_economy_marketplace_settlements_hold']
    `"Quantity" > 0 AND "RefundedQuantity" BETWEEN 0 AND "Quantity" AND "UnitPriceSnapshot" >= 0 AND "PriceVersionSnapshot" > 0` [name: 'ck_economy_marketplace_settlements_order_snapshot']
    `"ReserveVersion" > 0 AND "JournalSequence" > 0` [name: 'ck_economy_marketplace_settlements_receipt']
    `"Status" BETWEEN 1 AND 3` [name: 'ck_economy_marketplace_settlements_state']
    `"PolicyVersion" > 0 AND "Version" > 0` [name: 'ck_economy_marketplace_settlements_version']
    `"BuyerWalletId" <> "SellerWalletId" AND "BuyerWalletId" <> "PlatformFeeWalletId" AND "SellerWalletId" <> "PlatformFeeWalletId"` [name: 'ck_economy_marketplace_settlements_wallets']
  }

  Indexes {
    Id [pk, name: "PK_economy_marketplace_settlements"]
    (TenantId, BuyerId, SettledAt) [name: "IX_economy_marketplace_settlements_TenantId_BuyerId_SettledAt"]
    (TenantId, IdempotencyKey) [unique, name: "IX_economy_marketplace_settlements_TenantId_IdempotencyKey"]
    (TenantId, OrderId) [unique, name: "IX_economy_marketplace_settlements_TenantId_OrderId"]
    (TenantId, SellerId, SettledAt) [name: "IX_economy_marketplace_settlements_TenantId_SellerId_SettledAt"]
  }
}

