  "RequiredHardReserveUsdMinor" bigint [not null]
  "SoftFaceValueUsdNanos" bigint [not null]
  "StressedExpectedRedemptionCostUsdNanos" bigint [not null]
  "RequiredSoftReserveUsdNanos" bigint [not null]
  "HardBackingUsdNanos" bigint [not null]
  "SoftBackingUsdNanos" bigint [not null]
  "Coverage" integer [not null]
  "EvidenceHash" "character varying(128)" [not null]
  "ActivatedAt" timestamp [not null]

  Checks {
    `"HardFaceValueUsdMinor" >= 0 AND "RequiredHardReserveUsdMinor" >= 0 AND "SoftFaceValueUsdNanos" >= 0 AND "StressedExpectedRedemptionCostUsdNanos" >= 0 AND "RequiredSoftReserveUsdNanos" >= 0 AND "HardBackingUsdNanos" >= 0 AND "SoftBackingUsdNanos" >= 0` [name: 'ck_economy_reserve_heads_amounts_nonnegative']
    `"Coverage" IN (1, 2) AND length(btrim("EvidenceHash")) > 0` [name: 'ck_economy_reserve_heads_values_valid']
    `"Version" > 0 AND "PolicyVersion" > 0 AND "AuthorizationEpoch" > 0` [name: 'ck_economy_reserve_heads_versions_positive']
    `"ExpiresAt" > "ObservedAt" AND "ActivatedAt" >= "ObservedAt"` [name: 'ck_economy_reserve_heads_window']
  }

  Indexes {
    Version [pk, name: "PK_economy_reserve_heads"]
    IsActive [unique, name: "ux_economy_reserve_heads_active"]
    AuthorizationEpoch [unique, name: "ux_economy_reserve_heads_authorization_epoch"]
  }
}

