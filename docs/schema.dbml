Table "economy_custody_reconciliations" {
  "Id" uuid [not null]
  "ReserveVersion" bigint [not null]
  "ObservationIds" jsonb [not null]
  "LiabilityUsdNanos" bigint [not null]
  "EligibleAssetUsdNanos" bigint [not null]
  "VarianceUsdNanos" bigint [not null]
  "IsReconciled" boolean [not null]
  "EvidenceHash" "character varying(128)" [not null]
  "ReconciledBy" uuid [not null]
  "ReconciledAt" timestamp [not null]

  Checks {
    `"ReserveVersion" > 0 AND "LiabilityUsdNanos" >= 0 AND "EligibleAssetUsdNanos" >= 0` [name: 'ck_economy_custody_reconciliations_values']
  }

  Indexes {
