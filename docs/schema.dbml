    Id [pk, name: "PK_economy_chain_head"]
  }
}

Table "economy_compliance_evidence" {
  "Id" uuid [not null]
  "Provider" "character varying(100)" [not null]
  "Environment" "character varying(50)" [not null]
  "ProviderEventId" "character varying(256)" [not null]
  "TenantId" uuid [not null]
  "SubjectHash" "character varying(128)" [not null]
  "EvidenceKind" "character varying(100)" [not null]
  "JurisdictionCode" character(3)
  "Version" bigint [not null]
  "Result" "character varying(100)" [not null]
  "PolicyVersion" bigint [not null]
  "PayloadHash" "character varying(128)" [not null]
  "SignatureVerified" boolean [not null]
  "RawObjectReference" "character varying(1000)" [not null]
  "EvidenceHash" "character varying(128)" [not null]
  "IssuedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "ReceivedAt" timestamp [not null]

  Checks {
    `"JurisdictionCode" IS NULL OR "JurisdictionCode" ~ '^[A-Z]{3}$'` [name: 'ck_economy_compliance_evidence_jurisdiction']
    `"ExpiresAt" > "IssuedAt" AND "ReceivedAt" >= "IssuedAt"` [name: 'ck_economy_compliance_evidence_lifetime']
    `"Version" > 0 AND "PolicyVersion" > 0 AND length(btrim("EvidenceKind")) > 0` [name: 'ck_economy_compliance_evidence_versions']
  }

  Indexes {
    Id [pk, name: "PK_economy_compliance_evidence"]
    (Provider, Environment, ProviderEventId) [unique, name: "ux_economy_compliance_evidence_provider_event"]
    (TenantId, SubjectHash, EvidenceKind, Version) [unique, name: "ux_economy_compliance_evidence_subject_version"]
  }
}

Table "economy_compliance_holds" {
  "Id" uuid [not null]
  "ScopeKey" "character varying(512)" [not null]
  "TenantId" uuid [not null]
  "SubjectHash" "character varying(128)" [not null]
  "Capability" integer
  "CaseReferenceHash" "character varying(128)" [not null]
  "ReasonCode" "character varying(100)" [not null]
  "EvidenceHash" "character varying(128)" [not null]
  "IdempotencyKeyHash" "character varying(128)" [not null]
  "RequestHash" "character varying(128)" [not null]
  "ActivatedBy" uuid [not null]
  "ActivatedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "ReleaseProposedBy" uuid
  "ReleaseProposedAt" timestamp
  "RequiredReleaseApprovals" integer
  "ReleasePolicyEvidenceHash" "character varying(128)"
  "ReleasedBy" uuid
  "ReleasedAt" timestamp

  Checks {
    `"ExpiresAt" > "ActivatedAt"` [name: 'ck_economy_compliance_holds_lifetime']
    `("ReleasedAt" IS NULL AND "ReleasedBy" IS NULL) OR ("ReleasedAt" >= "ActivatedAt" AND "ReleasedBy" IS NOT NULL)` [name: 'ck_economy_compliance_holds_release']
    `("ReleaseProposedAt" IS NULL AND "ReleaseProposedBy" IS NULL AND "RequiredReleaseApprovals" IS NULL AND "ReleasePolicyEvidenceHash" IS NULL) OR ("ReleaseProposedAt" >= "ActivatedAt" AND "ReleaseProposedBy" IS NOT NULL AND "RequiredReleaseApprovals" BETWEEN 1 AND 2 AND length(btrim("ReleasePolicyEvidenceHash")) > 0)` [name: 'ck_economy_compliance_holds_release_proposal']
  }

  Indexes {
    Id [pk, name: "PK_economy_compliance_holds"]
    (ScopeKey, ReleasedAt, ExpiresAt) [name: "ix_economy_compliance_holds_active_scope"]
    (TenantId, SubjectHash, ExpiresAt) [name: "IX_economy_compliance_holds_TenantId_SubjectHash_ExpiresAt"]
    IdempotencyKeyHash [unique, name: "ux_economy_compliance_holds_idempotency"]
  }
}

