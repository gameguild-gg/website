Table "AssessmentSubmissions" {
  "Id" uuid [not null]
  "AssessmentId" uuid [not null]
  "DefinitionRevisionId" uuid
  "EnrollmentId" uuid
  "UserId" uuid
  "CourseGroupId" uuid
  "StartedByUserId" uuid [not null]
  "AttemptNumber" integer [not null]
  "DraftVersion" bigint [not null]
  "Score" integer
  "Passed" boolean
  "StartedAt" timestamp [not null]
  "SubmittedAt" timestamp
  "SubmittedByUserId" uuid
  "GradedAt" timestamp
  "GradedBy" uuid
  "Feedback" text
  "Status" integer [not null]
  "IsLate" boolean [not null]
  "SubmittedModalities" integer [not null]
  "TextPayload" text
  "FilePayload" "character varying(2048)"
  "UrlPayload" "character varying(2048)"
  "CodePayload" text
  "MediaPayload" "character varying(2048)"
  "ProjectPayload" "character varying(2048)"
  "RubricScoresPayload" jsonb
  "StructuredAnswerPayload" jsonb
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `"AttemptNumber" > 0` [name: 'CK_AssessmentSubmissions_AttemptNumberPositive']
    `"DraftVersion" >= 0` [name: 'CK_AssessmentSubmissions_DraftVersion']
    `(("SubmittedModalities" & 1) = 0 OR "TextPayload" IS NOT NULL) AND (("SubmittedModalities" & 2) = 0 OR "FilePayload" IS NOT NULL) AND (("SubmittedModalities" & 4) = 0 OR "UrlPayload" IS NOT NULL) AND (("SubmittedModalities" & 8) = 0 OR "CodePayload" IS NOT NULL) AND (("SubmittedModalities" & 16) = 0 OR "MediaPayload" IS NOT NULL) AND (("SubmittedModalities" & 32) = 0 OR "ProjectPayload" IS NOT NULL) AND (("SubmittedModalities" & 64) = 0 OR "StructuredAnswerPayload" IS NOT NULL) AND ("TextPayload" IS NULL OR ("SubmittedModalities" & 1) <> 0) AND ("FilePayload" IS NULL OR ("SubmittedModalities" & 2) <> 0) AND ("UrlPayload" IS NULL OR ("SubmittedModalities" & 4) <> 0) AND ("CodePayload" IS NULL OR ("SubmittedModalities" & 8) <> 0) AND ("MediaPayload" IS NULL OR ("SubmittedModalities" & 16) <> 0) AND ("ProjectPayload" IS NULL OR ("SubmittedModalities" & 32) <> 0) AND ("StructuredAnswerPayload" IS NULL OR ("SubmittedModalities" & 64) <> 0)` [name: 'CK_AssessmentSubmissions_PayloadConsistency']
    `"Score" IS NULL OR "Score" >= 0` [name: 'CK_AssessmentSubmissions_ScoreCanonical']
    `"StartedByUserId" <> '00000000-0000-0000-0000-000000000000'` [name: 'CK_AssessmentSubmissions_Starter']
    `("EnrollmentId" IS NOT NULL AND "UserId" IS NOT NULL AND "CourseGroupId" IS NULL) OR ("EnrollmentId" IS NULL AND "UserId" IS NULL AND "CourseGroupId" IS NOT NULL)` [name: 'CK_AssessmentSubmissions_Subject']
    `"SubmittedModalities" >= 0 AND ("SubmittedModalities" & ~127) = 0` [name: 'CK_AssessmentSubmissions_SubmittedModalities']
  }

  Indexes {
    Id [pk, name: "PK_AssessmentSubmissions"]
    AssessmentId [name: "IX_AssessmentSubmissions_AssessmentId"]
    CourseGroupId [name: "IX_AssessmentSubmissions_CourseGroupId"]
    (DefinitionRevisionId, AssessmentId) [name: "IX_AssessmentSubmissions_DefinitionRevisionId_AssessmentId"]
    EnrollmentId [name: "IX_AssessmentSubmissions_EnrollmentId"]
    UserId [name: "IX_AssessmentSubmissions_UserId"]
    (AssessmentId, EnrollmentId, AttemptNumber) [unique, name: "UX_AssessmentSubmissions_Assessment_Enrollment_Attempt"]
    (AssessmentId, CourseGroupId, AttemptNumber) [unique, name: "UX_AssessmentSubmissions_Assessment_Group_Attempt"]
  }
}

