Table "economy_reserve_heads" {
  "Version" bigint [not null]
  "IsActive" boolean [not null]
  "PolicyVersion" bigint [not null]
  "AuthorizationEpoch" bigint [not null]
  "ObservedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
