  }
}

Table "economy_custody_observations" {
  "Id" uuid [not null]
  "Provider" "character varying(100)" [not null]
  "AssetKey" "character varying(256)" [not null]
  "Purpose" integer [not null]
  "Version" bigint [not null]
  "EligibleUsdNanos" bigint [not null]
  "ObservedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "PayloadHash" "character varying(128)" [not null]
  "KeyId" "character varying(256)" [not null]
  "Signature" "character varying(2048)" [not null]

  Checks {
    `"ExpiresAt" > "ObservedAt"` [name: 'ck_economy_custody_observations_lifetime']
    `"Version" > 0 AND "EligibleUsdNanos" >= 0` [name: 'ck_economy_custody_observations_values']
  }

  Indexes {
