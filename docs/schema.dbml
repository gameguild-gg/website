Table "trust_safety_appeals" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "SubjectHash" "character varying(128)" [not null]
  "RestrictionReferenceHash" "character varying(128)" [not null]
  "State" integer [not null]
  "SubmittedBy" uuid [not null]
  "AssignedTo" uuid
  "DecidedBy" uuid
  "SubmissionEvidenceHash" "character varying(128)" [not null]
  "DecisionEvidenceHash" "character varying(128)"
  "ReasonCode" "character varying(100)"
  "SubmittedAt" timestamp [not null]
  "DecidedAt" timestamp
  "Version" bigint [not null]

  Checks {
    `("State" IN (1, 2) AND "DecidedAt" IS NULL AND "DecidedBy" IS NULL) OR ("State" IN (3, 4) AND "DecidedAt" IS NOT NULL AND "DecidedBy" IS NOT NULL)` [name: 'ck_trust_safety_appeals_decision']
    `"Version" > 0` [name: 'ck_trust_safety_appeals_version']
  }

  Indexes {
    Id [pk, name: "PK_trust_safety_appeals"]
    (TenantId, SubjectHash, State) [name: "IX_trust_safety_appeals_TenantId_SubjectHash_State"]
  }
}

Table "trust_safety_event_inbox" {
  "Id" uuid [not null]
  "EventId" "character varying(256)" [not null]
  "TenantId" uuid [not null]
  "SubjectHash" "character varying(128)" [not null]
  "Kind" integer [not null]
  "Version" bigint [not null]
  "Outcome" integer [not null]
  "PolicyVersion" bigint [not null]
  "PayloadHash" "character varying(128)" [not null]
  "EvidenceHash" "character varying(128)" [not null]
  "RawObjectReference" "character varying(2048)" [not null]
  "KeyId" "character varying(256)" [not null]
  "Signature" "character varying(2048)" [not null]
  "SignatureVerified" boolean [not null]
  "IssuedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "ReceivedAt" timestamp [not null]
  "ProcessedAt" timestamp
  "ProcessingError" "character varying(100)"

  Checks {
    `"ExpiresAt" > "IssuedAt" AND "ReceivedAt" >= "IssuedAt"` [name: 'ck_trust_safety_event_inbox_lifetime']
    `"Version" > 0 AND "PolicyVersion" > 0` [name: 'ck_trust_safety_event_inbox_version']
  }

  Indexes {
    Id [pk, name: "PK_trust_safety_event_inbox"]
    EventId [unique, name: "IX_trust_safety_event_inbox_EventId"]
    (TenantId, SubjectHash, Version) [unique, name: "IX_trust_safety_event_inbox_TenantId_SubjectHash_Version"]
  }
}

