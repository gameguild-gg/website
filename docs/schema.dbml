  "Provenance" integer [not null]
  "State" integer [not null]
  "ActorId" uuid [not null]
  "TenantId" uuid [not null]
  "PostingReferenceId" uuid
  "PolicyVersion" bigint [not null]
  "AuthoritativeUnits" bigint [not null]
  "ObservedAt" timestamp [not null]
  "ConfirmedAt" timestamp

  Checks {
    `("State" IN (2, 5, 6) AND "ConfirmedAt" IS NOT NULL AND "ConfirmedAt" >= "ObservedAt") OR ("State" IN (1, 3, 4) AND "ConfirmedAt" IS NULL)` [name: 'ck_economy_source_stamps_confirmation']
    `"AuthoritativeUnits" >= 0` [name: 'ck_economy_source_stamps_units_nonnegative']
  }

  Indexes {
