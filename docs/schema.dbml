Table "gameguild.authentication"."step_up_challenges" {
  "id" uuid [not null]
  "tenant_id" uuid [not null]
  "actor_id" uuid [not null]
  "session_id" uuid [not null]
  "operation_type" "character varying(128)" [not null]
  "target_reference" "character varying(256)" [not null]
  "payload_hash" character(64) [not null]
  "created_at" timestamp [not null]
  "expires_at" timestamp [not null]
  "verified_at" timestamp
  "verification_method" "character varying(32)"
  "receipt_hash" character(64)
  "consumed_at" timestamp

  Checks {
    `consumed_at IS NULL OR (verified_at IS NOT NULL AND consumed_at >= verified_at)` [name: 'ck_step_up_challenges_consumption']
    `expires_at > created_at` [name: 'ck_step_up_challenges_expiry']
    `payload_hash ~ '^[0-9a-f]{64}$'` [name: 'ck_step_up_challenges_payload_hash']
    `(verified_at IS NULL AND verification_method IS NULL AND receipt_hash IS NULL) OR (verified_at IS NOT NULL AND verification_method IS NOT NULL AND receipt_hash ~ '^[0-9a-f]{64}$')` [name: 'ck_step_up_challenges_verification']
  }

  Indexes {
    id [pk, name: "PK_step_up_challenges"]
    (tenant_id, actor_id, session_id, expires_at) [name: "ix_step_up_challenges_subject_expiry"]
    receipt_hash [unique, name: "ux_step_up_challenges_receipt_hash"]
  }
}

