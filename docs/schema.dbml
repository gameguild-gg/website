Table "resources"."actual_cloud_cost_entries" {
  "Id" uuid [not null]
  "Provider" "character varying(80)" [not null]
  "Source" "character varying(80)" [not null]
  "ExternalLineId" "character varying(300)" [not null]
  "ServiceCode" "character varying(120)" [not null]
  "UsageType" "character varying(200)" [not null]
  "ResourceId" "character varying(500)"
  "BillingPeriodStartUtc" timestamp [not null]
  "BillingPeriodEndUtc" timestamp [not null]
  "SourceCurrency" "character varying(3)" [not null]
  "SourceCost" numeric(28,12) [not null]
  "UsdCost" numeric(28,12) [not null]
  "IsUsdNormalizationPending" boolean [not null]
  "IsForecast" boolean [not null]
  "ImportedAtUtc" timestamp [not null]
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid [not null]

  Indexes {
    Id [pk, name: "PK_actual_cloud_cost_entries"]
    (Provider, Source, ExternalLineId) [unique, name: "IX_actual_cloud_cost_entries_Provider_Source_ExternalLineId"]
    (TenantId, BillingPeriodStartUtc) [name: "IX_actual_cloud_cost_entries_TenantId_BillingPeriodStartUtc"]
  }
}

Table "resources"."cloud_price_rates" {
  "Id" uuid [not null]
  "Provider" "character varying(80)" [not null]
  "ServiceCode" "character varying(120)" [not null]
  "MetricCode" "character varying(200)" [not null]
  "Region" "character varying(100)" [not null]
  "Unit" "character varying(80)" [not null]
  "SourceCurrency" "character varying(3)" [not null]
  "SourceUnitPrice" numeric(28,12) [not null]
  "UsdExchangeRate" numeric(28,12) [not null]
  "ProviderRateId" "character varying(300)" [not null]
  "EffectiveAtUtc" timestamp [not null]
  "RetrievedAtUtc" timestamp [not null]
  "ValidUntilUtc" timestamp
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Indexes {
    Id [pk, name: "PK_cloud_price_rates"]
    (Provider, MetricCode, Region, EffectiveAtUtc) [name: "IX_cloud_price_rates_Provider_MetricCode_Region_EffectiveAtUtc"]
    (Provider, ProviderRateId, EffectiveAtUtc) [unique, name: "IX_cloud_price_rates_Provider_ProviderRateId_EffectiveAtUtc"]
  }
}

Table "resources"."internal_cost_valuations" {
  "Id" uuid [not null]
  "UsageLedgerEntryId" uuid [not null]
  "CloudPriceRateId" uuid [not null]
  "SourceCurrency" "character varying(3)" [not null]
  "SourceUnitPrice" numeric(28,12) [not null]
  "SourceCost" numeric(28,12) [not null]
  "UsdExchangeRate" numeric(28,12) [not null]
  "UsdCost" numeric(28,12) [not null]
  "IsStaleEstimate" boolean [not null]
  "ValuedAtUtc" timestamp [not null]
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid [not null]

  Indexes {
    Id [pk, name: "PK_internal_cost_valuations"]
    (TenantId, ValuedAtUtc) [name: "IX_internal_cost_valuations_TenantId_ValuedAtUtc"]
    UsageLedgerEntryId [unique, name: "IX_internal_cost_valuations_UsageLedgerEntryId"]
  }
}

Table "resources"."internal_usage_ledger_entries" {
  "Id" uuid [not null]
  "EventId" uuid [not null]
  "EventName" "character varying(200)" [not null]
  "MetricCode" "character varying(200)" [not null]
  "Quantity" numeric(28,9) [not null]
  "Unit" "character varying(80)" [not null]
  "Provider" "character varying(80)" [not null]
  "Region" "character varying(100)" [not null]
  "CorrelationId" uuid [not null]
  "AggregateType" "character varying(200)" [not null]
  "AggregateId" "character varying(200)" [not null]
  "OccurredAtUtc" timestamp [not null]
  "ValuationStatus" "character varying(30)" [not null]
