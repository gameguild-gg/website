  Checks {
    `"SoftUnits" > 0 AND "LossBudgetUsdNanos" >= 0` [name: 'ck_economy_ad_reward_cap_consumptions_positive']
    `"Scope" BETWEEN 1 AND 6` [name: 'ck_economy_ad_reward_cap_consumptions_scope']
    `"WindowEndsAt" > "WindowStartedAt" AND "ConsumedAt" >= "WindowStartedAt" AND "ConsumedAt" < "WindowEndsAt"` [name: 'ck_economy_ad_reward_cap_consumptions_window']
  }

  Indexes {
    Id [pk, name: "PK_economy_ad_reward_cap_consumptions"]
    (SessionId, Scope) [unique, name: "IX_economy_ad_reward_cap_consumptions_SessionId_Scope"]
    (TenantId, Scope, SubjectHash, ConsumedAt) [name: "IX_economy_ad_reward_cap_consumptions_TenantId_Scope_SubjectHa~"]
  }
}

