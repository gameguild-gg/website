    (WalletId, DetectedAt) [name: "ix_economy_projection_reconciliation_events_wallet_detected"]
  }
}

Table "economy_provider_disputes" {
  "ProviderDisputeReference" "character varying(256)" [not null]
  "SourceStampId" uuid [not null]
  "ResponsibleWalletId" uuid [not null]
  "Status" integer [not null]
  "LatestProviderSequence" bigint [not null]
  "CumulativeDisputedHardUnits" bigint [not null]
  "BaselineReversedHardUnits" bigint [not null]
  "FrozenHardEquivalentUnits" bigint [not null]
  "ReversalIdempotencyKey" "character varying(128)"
  "UpdatedAt" timestamp [not null]
  "Version" bigint [not null]

  Checks {
    `"CumulativeDisputedHardUnits" > 0 AND "BaselineReversedHardUnits" >= 0 AND "BaselineReversedHardUnits" <= "CumulativeDisputedHardUnits" AND "FrozenHardEquivalentUnits" >= 0 AND "FrozenHardEquivalentUnits" <= ("CumulativeDisputedHardUnits" - "BaselineReversedHardUnits")` [name: 'ck_economy_provider_disputes_amount_partition']
    `("Status" = 1 AND "ReversalIdempotencyKey" IS NULL) OR ("Status" = 2 AND "FrozenHardEquivalentUnits" = 0 AND "ReversalIdempotencyKey" IS NULL) OR ("Status" = 3 AND "FrozenHardEquivalentUnits" = 0 AND "ReversalIdempotencyKey" IS NOT NULL)` [name: 'ck_economy_provider_disputes_lifecycle']
    `"LatestProviderSequence" > 0` [name: 'ck_economy_provider_disputes_sequence_positive']
    `"Version" > 0` [name: 'ck_economy_provider_disputes_version_positive']
  }

  Indexes {
    ProviderDisputeReference [pk, name: "PK_economy_provider_disputes"]
    ResponsibleWalletId [name: "IX_economy_provider_disputes_ResponsibleWalletId"]
    SourceStampId [unique, name: "ux_economy_provider_disputes_active_source"]
  }
}

Table "economy_risk_decisions" {
  "Id" uuid [not null]
  "Outcome" integer [not null]
  "OperationFingerprint" "character varying(128)" [not null]
  "IdempotencyKey" "character varying(128)"
  "ActorHash" "character varying(128)" [not null]
  "TemplateKind" integer [not null]
  "SourceWalletId" uuid [not null]
  "DestinationWalletId" uuid [not null]
  "Currency" integer [not null]
  "AmountUnits" bigint [not null]
  "CurrencyLegs" jsonb [not null]
  "SourceRoots" jsonb [not null]
  "ProviderReferenceHash" "character varying(128)" [not null]
  "PolicyVersion" bigint [not null]
  "ReserveVersion" bigint [not null]
  "ReserveAuthorizationEpoch" bigint [not null]
  "FeatureVersion" bigint [not null]
  "KillSwitchEpoch" bigint [not null]
  "CounterVersion" bigint [not null]
  "EntityGraphVersion" bigint [not null]
  "EntityGraphEvidenceHash" "character varying(128)" [not null]
  "ReasonCodes" jsonb [not null]
  "IssuedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_risk_decisions_amount_positive']
    `"ExpiresAt" > "IssuedAt"` [name: 'ck_economy_risk_decisions_lifetime']
    `"PolicyVersion" > 0 AND "ReserveVersion" > 0 AND "ReserveAuthorizationEpoch" > 0 AND "FeatureVersion" > 0 AND "CounterVersion" > 0 AND "EntityGraphVersion" >= 0` [name: 'ck_economy_risk_decisions_versions_positive']
  }

  Indexes {
    Id [pk, name: "PK_economy_risk_decisions"]
    DestinationWalletId [name: "IX_economy_risk_decisions_DestinationWalletId"]
    OperationFingerprint [unique, name: "ix_economy_risk_decisions_operation_fingerprint"]
    SourceWalletId [name: "IX_economy_risk_decisions_SourceWalletId"]
  }
}

Table "economy_wallet_balance_projections" {
  "WalletId" uuid [not null]
  "PendingHard" bigint [not null]
  "PendingSoft" bigint [not null]
  "PurchasedHard" bigint [not null]
  "EarnedHard" bigint [not null]
  "RestrictedHard" bigint [not null]
  "Soft" bigint [not null]
  "ImmatureEarnedHard" bigint [not null]
  "HeldHard" bigint [not null]
