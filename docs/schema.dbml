Table "economy_ad_network_policy_versions" {
  "TenantId" uuid [not null]
  "Network" "character varying(100)" [not null]
  "Version" bigint [not null]
  "EffectiveAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "IssuanceMode" integer [not null]
  "YieldState" integer [not null]
  "EstimatedNetEcpmUsdNanos" bigint [not null]
  "ContractedRevenueSharePpm" integer [not null]
  "SafetyBufferPpm" integer [not null]
  "MinimumVisiblePpm" integer [not null]
  "MaximumFocusLossTicks" bigint [not null]
  "MaximumRewardSoftUnits" bigint [not null]
  "ReportsCurrentThrough" timestamp [not null]
  "ReportStaleAfterTicks" bigint [not null]
  "Ranking" integer [not null]
  "MaximumUserSoftUnits" bigint [not null]
  "MaximumDeviceSoftUnits" bigint [not null]
  "MaximumIpSoftUnits" bigint [not null]
  "MaximumAsnSoftUnits" bigint [not null]
  "MaximumNetworkSoftUnits" bigint [not null]
  "MaximumGlobalSoftUnits" bigint [not null]
  "FundedLossBudgetUsdNanos" bigint [not null]
  "BudgetWindowTicks" bigint [not null]
  "ProviderHash" "character varying(128)" [not null]
  "ProviderCertified" boolean [not null]
  "CanonicalPayload" text [not null]
  "PayloadHash" "character varying(128)" [not null]
  "KeyId" "character varying(256)" [not null]
  "Signature" text [not null]
  "ProposedBy" uuid [not null]
  "ApprovedBy" uuid [not null]
  "PublishedAt" timestamp [not null]

  Checks {
    `"MaximumUserSoftUnits" > 0 AND "MaximumDeviceSoftUnits" > 0 AND "MaximumIpSoftUnits" > 0 AND "MaximumAsnSoftUnits" > 0 AND "MaximumNetworkSoftUnits" > 0 AND "MaximumGlobalSoftUnits" > 0 AND "FundedLossBudgetUsdNanos" > 0` [name: 'ck_economy_ad_network_policy_versions_caps']
    `"ProposedBy" <> "ApprovedBy"` [name: 'ck_economy_ad_network_policy_versions_dual_control']
    `"ContractedRevenueSharePpm" BETWEEN 0 AND 1000000 AND "SafetyBufferPpm" BETWEEN 0 AND 999999 AND "MinimumVisiblePpm" BETWEEN 0 AND 1000000` [name: 'ck_economy_ad_network_policy_versions_ppm']
    `"Version" > 0 AND "EstimatedNetEcpmUsdNanos" > 0 AND "MaximumRewardSoftUnits" > 0 AND "MaximumFocusLossTicks" >= 0 AND "ReportStaleAfterTicks" > 0 AND "Ranking" >= 0 AND "BudgetWindowTicks" > 0` [name: 'ck_economy_ad_network_policy_versions_values']
    `"ExpiresAt" > "EffectiveAt"` [name: 'ck_economy_ad_network_policy_versions_window']
  }

  Indexes {
    (TenantId, Network, Version) [pk, name: "PK_economy_ad_network_policy_versions"]
    (TenantId, Network, EffectiveAt, ExpiresAt) [name: "IX_economy_ad_network_policy_versions_TenantId_Network_Effecti~"]
  }
}

Table "economy_ad_provider_reports" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "Network" "character varying(100)" [not null]
  "ReportId" "character varying(256)" [not null]
  "Version" integer [not null]
  "BatchId" "character varying(256)" [not null]
  "PeriodStart" timestamp [not null]
  "PeriodEnd" timestamp [not null]
  "ActualRevenueUsdNanos" bigint [not null]
  "VerifiedSessionIds" jsonb [not null]
  "EvidenceHash" "character varying(128)" [not null]
  "ImportedAt" timestamp [not null]
  "Signature" text [not null]
  "PayloadHash" "character varying(128)" [not null]
  "SignatureVerified" boolean [not null]
  "ReceivedAt" timestamp [not null]
  "ProcessedAt" timestamp
  "ProcessingError" "character varying(256)"

  Checks {
    `"ActualRevenueUsdNanos" >= 0` [name: 'ck_economy_ad_provider_reports_revenue']
    `"Version" > 0` [name: 'ck_economy_ad_provider_reports_version']
    `"PeriodEnd" > "PeriodStart" AND "ImportedAt" >= "PeriodEnd"` [name: 'ck_economy_ad_provider_reports_window']
  }

  Indexes {
    Id [pk, name: "PK_economy_ad_provider_reports"]
    (TenantId, Network, BatchId, Version) [unique, name: "IX_economy_ad_provider_reports_TenantId_Network_BatchId_Version"]
    (TenantId, Network, ReportId, Version) [unique, name: "IX_economy_ad_provider_reports_TenantId_Network_ReportId_Versi~"]
  }
}

Table "economy_ad_reward_accumulators" {
  "TenantId" uuid [not null]
  "WalletId" uuid [not null]
  "Network" "character varying(100)" [not null]
  "PolicyVersion" bigint [not null]
  "RemainderNumerator" text [not null]
  "CanonicalDenominator" text [not null]
  "Version" bigint [not null]
  "UpdatedAt" timestamp [not null]

  Checks {
    `"RemainderNumerator" ~ '^[0-9]+$' AND "CanonicalDenominator" ~ '^[1-9][0-9]*$'` [name: 'ck_economy_ad_reward_accumulators_numbers']
    `"PolicyVersion" > 0 AND "Version" > 0` [name: 'ck_economy_ad_reward_accumulators_version']
  }

  Indexes {
    (TenantId, WalletId, Network) [pk, name: "PK_economy_ad_reward_accumulators"]
  }
}

Table "economy_ad_reward_attributions" {
  "SessionId" uuid [not null]
