Table "content_progress" {
  "Id" uuid [not null]
  "UserId" uuid [not null]
  "ContentId" uuid [not null]
  "ProgramEnrollmentId" uuid [not null]
  "CompletionStatus" integer [not null]
  "ProgressPercentage" integer [not null]
  "FirstAccessedAt" timestamp
  "LastAccessedAt" timestamp
  "CompletedAt" timestamp
  "TimeSpentSeconds" integer [not null]
  "Score" integer
  "MaxScore" integer
  "Attempts" integer [not null]
  "ProgressData" jsonb
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `"MaxScore" IS NULL OR ("MaxScore" >= 0)` [name: 'CK_content_progress_MaxScore_Canonical']
    `"ProgressPercentage" >= 0 AND "ProgressPercentage" <= 10000` [name: 'CK_content_progress_ProgressPercentage_Canonical']
    `"Score" IS NULL OR ("Score" >= 0)` [name: 'CK_content_progress_Score_Canonical']
    `"Score" IS NULL OR "MaxScore" IS NULL OR "Score" <= "MaxScore"` [name: 'CK_content_progress_ScoreRange']
  }

  Indexes {
    Id [pk, name: "PK_content_progress"]
    CompletedAt [name: "IX_content_progress_CompletedAt"]
