Table "Assessments" {
  "Id" uuid [not null]
  "CourseId" uuid [not null]
  "ContentId" uuid
  "AssessmentGroupId" uuid
  "GroupSetId" uuid
  "RubricId" uuid
  "Title" "character varying(500)" [not null]
  "Slug" "character varying(220)" [not null]
  "Description" "character varying(2000)"
  "Type" integer [not null]
  "MaxScore" integer [not null]
  "PassingScore" integer [not null]
  "TimeLimitMinutes" integer
  "MaxAttempts" integer [not null, default: 1]
  "IsRequired" boolean [not null]
  "Order" integer [not null]
  "AvailableFrom" timestamp
  "AvailableUntil" timestamp
  "DueAt" timestamp
  "AllowLateSubmissions" boolean [not null]
  "LateSubmissionDeadline" timestamp
  "SubmissionModalities" integer [not null]
  "PresentationMode" integer [not null]
  "ReviewMethods" integer [not null, default: 8]
  "ReviewConfigurationCanonicalJson" text
  "AttemptContributionMode" "character varying(32)"
  "ContentCompletionMode" "character varying(32)" [not null, default: 'on-release-and-pass']
  "ResultReleaseMode" "character varying(16)" [not null, default: 'manual']
  "ResultReleaseScheduledFor" timestamp
  "PublishedDefinitionRevisionId" uuid
  "DefinitionPayload" jsonb
  "DefinitionSchemaVersion" integer [not null, default: 1]
  "GradingMethods" integer [not null, default: 8]
  "PeerReviewsRequiredCount" integer [not null, default: 0]
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `("AvailableFrom" IS NULL OR "AvailableUntil" IS NULL OR "AvailableFrom" <= "AvailableUntil") AND ("DueAt" IS NULL OR "AvailableFrom" IS NULL OR "DueAt" >= "AvailableFrom") AND ("DueAt" IS NULL OR "AvailableUntil" IS NULL OR "DueAt" <= "AvailableUntil") AND (NOT "AllowLateSubmissions" OR ("DueAt" IS NOT NULL AND "LateSubmissionDeadline" IS NOT NULL AND "LateSubmissionDeadline" > "DueAt" AND ("AvailableUntil" IS NULL OR "LateSubmissionDeadline" <= "AvailableUntil"))) AND ("AllowLateSubmissions" OR "LateSubmissionDeadline" IS NULL)` [name: 'CK_Assessments_DeliverySchedule']
    `"GradingMethods" >= 0 AND ("GradingMethods" & ~15) = 0` [name: 'CK_Assessments_GradingMethods']
    `"MaxAttempts" >= 1` [name: 'CK_Assessments_MaxAttempts']
    `"PresentationMode" IN (0, 1)` [name: 'CK_Assessments_PresentationMode']
    `("ResultReleaseMode" = 'scheduled' AND "ResultReleaseScheduledFor" IS NOT NULL) OR ("ResultReleaseMode" <> 'scheduled' AND "ResultReleaseScheduledFor" IS NULL)` [name: 'CK_Assessments_ResultRelease']
    `"ReviewConfigurationCanonicalJson" IS NULL OR (octet_length("ReviewConfigurationCanonicalJson") <= 65536 AND jsonb_typeof("ReviewConfigurationCanonicalJson"::jsonb) = 'object' AND ("ReviewConfigurationCanonicalJson"::jsonb ->> 'schemaVersion') = '1')` [name: 'CK_Assessments_ReviewConfiguration']
    `"ReviewMethods" IN (0, 1, 2, 4, 8, 9, 10, 12, 16, 24)` [name: 'CK_Assessments_ReviewMethods']
    `"MaxScore" > 0 AND "PassingScore" >= 0 AND "PassingScore" <= "MaxScore"` [name: 'CK_Assessments_ScoreRange']
    `"SubmissionModalities" > 0 AND ("SubmissionModalities" & ~127) = 0` [name: 'CK_Assessments_SubmissionModalities']
  }

  Indexes {
    Id [pk, name: "PK_Assessments"]
    AssessmentGroupId [name: "IX_Assessments_AssessmentGroupId"]
    ContentId [unique, name: "IX_Assessments_ContentId"]
    CourseId [name: "IX_Assessments_CourseId"]
    (PublishedDefinitionRevisionId, Id) [name: "IX_Assessments_PublishedDefinitionRevisionId_Id"]
    Slug [name: "IX_Assessments_Slug"]
  }
}

