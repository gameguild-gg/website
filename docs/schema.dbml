Table "GradingCommandReceipts" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "ResourceId" uuid [not null]
  "CommandType" "character varying(128)" [not null]
  "ActorId" uuid [not null]
  "IdempotencyKey" "character varying(200)" [not null]
  "RequestHash" character(64) [not null]
  "OutcomeSchemaVersion" "character varying(64)" [not null]
  "OutcomeCanonicalJson" text [not null]
  "CreatedAt" timestamp [not null]
