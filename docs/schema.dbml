  "RewardSoftUnits" bigint [not null]
  "CompletedAt" timestamp [not null]

  Checks {
    `"EstimatedRevenueUsdNanos" >= 0 AND "RewardSoftUnits" >= 0` [name: 'ck_economy_ad_reward_attributions_nonnegative']
  }

  Indexes {
    SessionId [pk, name: "PK_economy_ad_reward_attributions"]
    (Network, ProviderBatchId, CompletedAt) [name: "IX_economy_ad_reward_attributions_Network_ProviderBatchId_Comp~"]
  }
}

Table "economy_ad_reward_budget_consumptions" {
  "SessionId" uuid [not null]
  "TenantId" uuid [not null]
  "UserId" uuid [not null]
  "DeviceRiskHash" "character varying(128)" [not null]
  "Network" "character varying(100)" [not null]
  "SoftUnits" bigint [not null]
  "LossBudgetUsdNanos" bigint [not null]
  "ConsumedAt" timestamp [not null]

  Checks {
    `"SoftUnits" > 0 AND "LossBudgetUsdNanos" > 0` [name: 'ck_economy_ad_reward_budget_consumptions_positive']
  }

  Indexes {
    SessionId [pk, name: "PK_economy_ad_reward_budget_consumptions"]
    (DeviceRiskHash, ConsumedAt) [name: "IX_economy_ad_reward_budget_consumptions_DeviceRiskHash_Consum~"]
    (Network, ConsumedAt) [name: "IX_economy_ad_reward_budget_consumptions_Network_ConsumedAt"]
    (UserId, ConsumedAt) [name: "IX_economy_ad_reward_budget_consumptions_UserId_ConsumedAt"]
  }
}

Table "economy_ad_reward_completions" {
  "SessionId" uuid [not null]
  "TenantId" uuid [not null]
  "UserId" uuid [not null]
  "WalletId" uuid [not null]
  "Network" "character varying(100)" [not null]
  "PolicyVersion" bigint [not null]
  "IdempotencyKey" "character varying(256)" [not null]
  "State" integer [not null]
  "RewardSoftUnits" bigint [not null]
  "SourceStampId" uuid
  "PostingId" uuid
  "OutputLotId" uuid
  "ProviderEventId" "character varying(256)"
  "CapabilityReceiptId" uuid
  "CapabilityReceiptHash" "character varying(128)"
  "ReserveVersion" bigint
  "RiskDecisionId" uuid
  "KillSwitchEpoch" bigint
  "JurisdictionCode" "character varying(16)"
  "ProviderHash" "character varying(128)"
  "DestinationHash" "character varying(128)"
  "EvidenceHashes" jsonb [not null]
  "CompletedAt" timestamp [not null]
  "Version" bigint [not null]

  Checks {
    `"State" <> 1 OR ("RewardSoftUnits" > 0 AND "SourceStampId" IS NOT NULL AND "PostingId" IS NOT NULL AND "OutputLotId" IS NOT NULL)` [name: 'ck_economy_ad_reward_completions_issued_binding']
    `"RewardSoftUnits" >= 0` [name: 'ck_economy_ad_reward_completions_reward_nonnegative']
    `"State" BETWEEN 1 AND 3` [name: 'ck_economy_ad_reward_completions_state']
  }

  Indexes {
    SessionId [pk, name: "PK_economy_ad_reward_completions"]
    IdempotencyKey [unique, name: "IX_economy_ad_reward_completions_IdempotencyKey"]
    (Network, PolicyVersion) [name: "IX_economy_ad_reward_completions_Network_PolicyVersion"]
    ProviderEventId [unique, name: "IX_economy_ad_reward_completions_ProviderEventId"]
    (UserId, CompletedAt) [name: "IX_economy_ad_reward_completions_UserId_CompletedAt"]
  }
}

Table "economy_ad_reward_sessions" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "UserId" uuid [not null]
  "WalletId" uuid [not null]
  "Network" "character varying(100)" [not null]
  "PolicyVersion" bigint [not null]
  "CreativeId" "character varying(256)" [not null]
  "DeviceRiskHash" "character varying(128)" [not null]
  "IpRiskHash" "character varying(128)" [not null]
  "AsnRiskHash" "character varying(128)" [not null]
  "NonceHash" "character varying(128)" [not null]
  "TokenHash" "character varying(128)" [not null]
  "TokenKeyId" "character varying(256)" [not null]
  "RequiredDurationTicks" bigint [not null]
  "State" integer [not null]
  "StartIdempotencyKeyHash" "character varying(128)" [not null]
  "StartRequestHash" "character varying(128)" [not null]
  "IssuedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "Version" bigint [not null]

  Checks {
    `"State" BETWEEN 1 AND 7` [name: 'ck_economy_ad_reward_sessions_state']
    `"PolicyVersion" > 0 AND "RequiredDurationTicks" > 0 AND "Version" > 0` [name: 'ck_economy_ad_reward_sessions_values']
    `"ExpiresAt" > "IssuedAt" AND "UpdatedAt" >= "IssuedAt"` [name: 'ck_economy_ad_reward_sessions_window']
  }

  Indexes {
    Id [pk, name: "PK_economy_ad_reward_sessions"]
    (TenantId, NonceHash) [unique, name: "IX_economy_ad_reward_sessions_TenantId_NonceHash"]
    (TenantId, StartIdempotencyKeyHash) [unique, name: "IX_economy_ad_reward_sessions_TenantId_StartIdempotencyKeyHash"]
    (TenantId, UserId, IssuedAt) [name: "IX_economy_ad_reward_sessions_TenantId_UserId_IssuedAt"]
  }
}

Table "economy_admin_withdrawal_runs" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "IdempotencyKey" "character varying(256)" [not null]
  "RequestHash" "character varying(128)" [not null]
  "PeriodStart" date [not null]
  "RequestedBy" uuid [not null]
  "ApprovedBy" uuid
  "PlatformFeeWalletId" uuid [not null]
  "AmountUnits" bigint [not null]
  "SourceAssetKey" "character varying(256)" [not null]
  "DestinationHash" "character varying(128)" [not null]
  "State" integer [not null]
  "Version" bigint [not null]
  "FencingToken" bigint [not null]
  "ExecutionEpoch" bigint [not null]
  "ReserveVersion" bigint [not null]
  "ReserveAuthorizationEpoch" bigint [not null]
  "PolicyVersion" bigint [not null]
  "DispatchSnapshotHash" "character varying(128)"
  "ProviderTransferId" "character varying(256)"
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_admin_withdrawal_runs_amount_positive']
    `("State" = 1 AND "ApprovedBy" IS NULL) OR ("State" BETWEEN 2 AND 7 AND "ApprovedBy" IS NOT NULL)` [name: 'ck_economy_admin_withdrawal_runs_approval']
    `("State" IN (1, 2) AND "DispatchSnapshotHash" IS NULL) OR ("State" BETWEEN 3 AND 7 AND "DispatchSnapshotHash" IS NOT NULL)` [name: 'ck_economy_admin_withdrawal_runs_dispatch_snapshot']
    `"Version" > 0 AND "FencingToken" > 0 AND "ExecutionEpoch" > 0 AND "ReserveVersion" > 0 AND "ReserveAuthorizationEpoch" > 0 AND "PolicyVersion" > 0` [name: 'ck_economy_admin_withdrawal_runs_positive_versions']
    `"State" BETWEEN 1 AND 7` [name: 'ck_economy_admin_withdrawal_runs_state']
    `"UpdatedAt" >= "CreatedAt"` [name: 'ck_economy_admin_withdrawal_runs_timestamps']
  }

  Indexes {
    Id [pk, name: "PK_economy_admin_withdrawal_runs"]
    (State, UpdatedAt) [name: "ix_economy_admin_withdrawal_runs_state_updated"]
    (TenantId, PeriodStart) [unique, name: "ux_economy_admin_withdrawal_runs_active_period"]
    (TenantId, IdempotencyKey) [unique, name: "ux_economy_admin_withdrawal_runs_idempotency"]
  }
}

Table "economy_bounties" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "PosterId" uuid [not null]
  "PosterWalletId" uuid [not null]
  "EscrowWalletId" uuid [not null]
  "Currency" integer [not null]
  "AmountUnits" bigint [not null]
  "ReclaimFeePpm" integer [not null]
  "RequiresPrerequisite" boolean [not null]
  "MinimumReputation" integer [not null]
  "RequiresInstructorVerification" boolean [not null]
  "Status" integer [not null]
  "IdempotencyKey" "character varying(256)" [not null]
  "RequestHash" "character varying(128)"
  "PostedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "Version" bigint [not null]

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_bounties_amount_positive']
    `"ReclaimFeePpm" BETWEEN 0 AND 999999` [name: 'ck_economy_bounties_fee']
    `"MinimumReputation" >= 0` [name: 'ck_economy_bounties_reputation']
    `"Status" BETWEEN 1 AND 4` [name: 'ck_economy_bounties_state']
    `"Version" > 0` [name: 'ck_economy_bounties_version']
    `"ExpiresAt" > "PostedAt"` [name: 'ck_economy_bounties_window']
  }

  Indexes {
    Id [pk, name: "PK_economy_bounties"]
    IdempotencyKey [unique, name: "IX_economy_bounties_IdempotencyKey"]
    (TenantId, PosterId, Status, ExpiresAt) [name: "IX_economy_bounties_TenantId_PosterId_Status_ExpiresAt"]
    (TenantId, Status, ExpiresAt) [name: "IX_economy_bounties_TenantId_Status_ExpiresAt"]
  }
}

Table "economy_capability_policies" {
  "Id" uuid [not null]
  "ScopeKey" "character varying(256)" [not null]
  "TenantId" uuid
  "Capability" integer [not null]
  "JurisdictionCode" "character varying(16)" [not null]
  "Version" bigint [not null]
  "CanonicalPayload" jsonb [not null]
  "PayloadHash" "character varying(128)" [not null]
  "KeyId" "character varying(256)" [not null]
  "Signature" "character varying(2048)" [not null]
  "RequestHash" "character varying(128)" [not null]
  "ProposedBy" uuid [not null]
  "ApprovedBy" uuid
  "ProposedAt" timestamp [not null]
  "ApprovedAt" timestamp
  "EffectiveAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "ProviderReady" boolean [not null]
  "IsActive" boolean [not null]

  Checks {
    `("ApprovedBy" IS NULL AND "ApprovedAt" IS NULL AND NOT "IsActive") OR ("ApprovedBy" IS NOT NULL AND "ApprovedBy" <> "ProposedBy" AND "ApprovedAt" >= "ProposedAt")` [name: 'ck_economy_capability_policies_dual_control']
    `"Version" > 0` [name: 'ck_economy_capability_policies_version']
    `"ExpiresAt" > "EffectiveAt" AND ("ApprovedAt" IS NULL OR "EffectiveAt" >= "ApprovedAt")` [name: 'ck_economy_capability_policies_window']
  }

  Indexes {
    Id [pk, name: "PK_economy_capability_policies"]
    ScopeKey [unique, name: "ux_economy_capability_policies_active_scope"]
    RequestHash [unique, name: "ux_economy_capability_policies_request_hash"]
    (ScopeKey, Version) [unique, name: "ux_economy_capability_policies_scope_version"]
  }
}

Table "economy_chain_head" {
  "Id" smallint [increment]
  "Sequence" bigint [not null]
  "Hash" "character varying(128)" [not null]
  "UpdatedAt" timestamp [not null]

  Checks {
    `"Id" = 1` [name: 'ck_economy_chain_head_singleton']
  }

