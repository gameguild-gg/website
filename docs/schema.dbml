Table "economy_kill_switches" {
  "Id" uuid [not null]
  "ScopeKey" "character varying(256)" [not null]
  "TenantId" uuid
  "Capability" integer
  "Epoch" bigint [not null]
  "IsActive" boolean [not null]
  "Reason" "character varying(1000)" [not null]
