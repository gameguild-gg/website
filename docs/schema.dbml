  "ProviderReferenceHash" "character varying(128)" [not null]
  "DestinationHash" "character varying(128)" [not null]
  "RequestedAt" timestamp [not null]

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_self_service_transfer_intents_amount_positive']
    `("Currency" = 1 AND "Provenance" = 1) OR ("Currency" = 2 AND "Provenance" = 3)` [name: 'ck_economy_self_service_transfer_intents_currency_provenance']
    `"ActorId" <> "RecipientUserId"` [name: 'ck_economy_self_service_transfer_intents_parties_distinct']
    `"TransferType" IN (1, 2, 3)` [name: 'ck_economy_self_service_transfer_intents_type_valid']
