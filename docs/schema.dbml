Table "economy_payout_operations" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "IdempotencyKey" "character varying(256)" [not null]
  "RequestHash" "character varying(128)" [not null]
  "ActorId" uuid [not null]
  "PayeeId" uuid [not null]
  "WalletId" uuid [not null]
  "AmountUnits" bigint [not null]
  "ProviderAccountId" "character varying(256)" [not null]
  "DestinationHash" "character varying(128)" [not null]
  "ProviderBindingHash" "character varying(128)" [not null]
  "EligibilityHash" "character varying(128)" [not null]
  "DispatchSnapshotHash" "character varying(128)"
  "ProviderPayoutId" "character varying(256)"
  "State" integer [not null]
  "Version" bigint [not null]
  "FencingToken" bigint [not null]
  "KillSwitchEpoch" bigint [not null]
  "ReserveVersion" bigint [not null]
  "ReserveAuthorizationEpoch" bigint [not null]
  "PolicyVersion" bigint [not null]
  "RiskDecisionId" uuid [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]

  Checks {
    `("State" = 1 AND "DispatchSnapshotHash" IS NULL) OR ("State" BETWEEN 2 AND 6 AND "DispatchSnapshotHash" IS NOT NULL)` [name: 'ck_economy_payout_operations_dispatch']
    `"AmountUnits" > 0 AND "Version" > 0 AND "FencingToken" > 0 AND "KillSwitchEpoch" >= 0 AND "ReserveVersion" > 0 AND "ReserveAuthorizationEpoch" > 0 AND "PolicyVersion" > 0` [name: 'ck_economy_payout_operations_positive_values']
    `"State" BETWEEN 1 AND 6` [name: 'ck_economy_payout_operations_state']
    `"UpdatedAt" >= "CreatedAt"` [name: 'ck_economy_payout_operations_timestamps']
  }

  Indexes {
    Id [pk, name: "PK_economy_payout_operations"]
    (State, UpdatedAt) [name: "ix_economy_payout_operations_state_updated"]
    (TenantId, State, UpdatedAt) [name: "ix_economy_payout_operations_tenant_state_updated"]
    (TenantId, IdempotencyKey) [unique, name: "ux_economy_payout_operations_tenant_idempotency"]
  }
}

Table "economy_projection_generations" {
  "Id" uuid [not null]
