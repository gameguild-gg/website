  "ProgramUserId" uuid [not null]
  "Points" integer
  "MaxPoints" integer
  "GradeLetter" "character varying(10)"
  "Feedback" text
  "GradedAt" timestamp [not null]
  "IsFinalized" boolean [not null]
  "RubricData" text
  "GradingTimeMinutes" integer
  "GradeType" integer [not null]
  "AttemptNumber" integer [not null]
  "GraderProgramUserId" uuid
  "GradingDetails" text
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `"MaxPoints" IS NULL OR ("MaxPoints" >= 0)` [name: 'CK_activity_grades_MaxPoints_Canonical']
    `"Points" IS NULL OR ("Points" >= 0)` [name: 'CK_activity_grades_Points_Canonical']
    `"Points" IS NULL OR "MaxPoints" IS NULL OR "Points" <= "MaxPoints"` [name: 'CK_activity_grades_ScoreRange']
  }

  Indexes {
    Id [pk, name: "PK_activity_grades"]
    ContentInteractionId [name: "IX_activity_grades_ContentInteractionId"]
    GradedAt [name: "IX_activity_grades_GradedAt"]
    GraderId [name: "IX_activity_grades_GraderId"]
    GraderProgramUserId [name: "IX_activity_grades_GraderProgramUserId"]
    Points [name: "IX_activity_grades_Points"]
    ProgramUserId [name: "IX_activity_grades_ProgramUserId"]
    StudentId [name: "IX_activity_grades_StudentId"]
    (StudentId, ContentInteractionId) [unique, name: "IX_activity_grades_StudentId_ContentInteractionId"]
    TenantId [name: "IX_activity_grades_TenantId"]
  }
}

Table "content_interaction_events" {
  "Id" uuid [not null]
  "InteractionId" uuid [not null]
  "Type" integer [not null]
  "OccurredAt" timestamp [not null]
  "DurationSeconds" integer
  "PositionSeconds" numeric(12,3)
  "ProgressPercentage" integer
  "Payload" text
  "IdempotencyKey" "character varying(128)"
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `"DurationSeconds" IS NULL OR "DurationSeconds" > 0` [name: 'CK_content_interaction_events_DurationSeconds_Positive']
    `"PositionSeconds" IS NULL OR "PositionSeconds" >= 0` [name: 'CK_content_interaction_events_PositionSeconds_NonNegative']
    `"ProgressPercentage" IS NULL OR ("ProgressPercentage" >= 0 AND "ProgressPercentage" <= 10000)` [name: 'CK_content_interaction_events_ProgressPercentage_Canonical']
    `"Type" BETWEEN 0 AND 8` [name: 'CK_content_interaction_events_Type_Valid']
  }

  Indexes {
    Id [pk, name: "PK_content_interaction_events"]
    (InteractionId, IdempotencyKey) [unique, name: "IX_content_interaction_events_InteractionId_IdempotencyKey"]
    (InteractionId, OccurredAt) [name: "IX_content_interaction_events_InteractionId_OccurredAt"]
  }
}

