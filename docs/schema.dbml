Table "economy_top_up_intents" {
  "Id" uuid [not null]
  "PaymentId" uuid [not null]
  "TenantId" uuid [not null]
  "ActorId" uuid [not null]
  "WalletId" uuid [not null]
  "HardCoinUnits" bigint [not null]
  "UsdMinorUnits" bigint [not null]
  "JurisdictionCode" "character varying(16)" [not null]
  "PolicyVersion" bigint [not null]
  "PolicyHash" "character varying(128)" [not null]
  "Provider" "character varying(64)" [not null]
  "IdempotencyKey" "character varying(128)" [not null]
  "RequestHash" "character varying(128)" [not null]
  "ProviderEnvironment" "character varying(32)"
  "ProviderAccountId" "character varying(255)"
  "ProviderObjectId" "character varying(255)"
  "ProviderObjectType" "character varying(100)"
  "ProviderMonetaryLeg" "character varying(100)"
  "Status" integer [not null]
  "RequestedAt" timestamp [not null]
  "ProviderBoundAt" timestamp
  "LastProviderEventId" "character varying(255)"
  "LastProviderEventAt" timestamp
  "LastProviderEvidenceHash" "character varying(128)"
  "PostingGroupId" uuid
  "FailureCode" "character varying(100)"
  "UpdatedAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "Version" bigint [not null]

  Checks {
    `"HardCoinUnits" > 0 AND "UsdMinorUnits" > 0` [name: 'ck_economy_top_up_intents_amount_positive']
    `("LastProviderEventId" IS NULL AND "LastProviderEventAt" IS NULL AND "LastProviderEvidenceHash" IS NULL) OR ("LastProviderEventId" IS NOT NULL AND "LastProviderEventAt" IS NOT NULL AND "LastProviderEvidenceHash" IS NOT NULL)` [name: 'ck_economy_top_up_intents_event_state']
    `("Status" = 5 AND "PostingGroupId" IS NOT NULL) OR ("Status" <> 5 AND "PostingGroupId" IS NULL)` [name: 'ck_economy_top_up_intents_posting_state']
    `("Status" = 1 AND "ProviderEnvironment" IS NULL AND "ProviderAccountId" IS NULL AND "ProviderObjectId" IS NULL AND "ProviderObjectType" IS NULL AND "ProviderMonetaryLeg" IS NULL AND "ProviderBoundAt" IS NULL) OR ("Status" <> 1 AND "ProviderEnvironment" IS NOT NULL AND "ProviderAccountId" IS NOT NULL AND "ProviderObjectId" IS NOT NULL AND "ProviderObjectType" IS NOT NULL AND "ProviderMonetaryLeg" IS NOT NULL AND "ProviderBoundAt" IS NOT NULL)` [name: 'ck_economy_top_up_intents_provider_binding']
    `"Version" > 0` [name: 'ck_economy_top_up_intents_version_positive']
  }

  Indexes {
    Id [pk, name: "PK_economy_top_up_intents"]
    PostingGroupId [name: "IX_economy_top_up_intents_PostingGroupId"]
    WalletId [name: "IX_economy_top_up_intents_WalletId"]
    (TenantId, ActorId, IdempotencyKey) [unique, name: "ux_economy_top_up_intents_actor_key"]
    PaymentId [unique, name: "ux_economy_top_up_intents_payment"]
    (Provider, ProviderEnvironment, ProviderAccountId, ProviderObjectId, ProviderObjectType, ProviderMonetaryLeg) [unique, name: "ux_economy_top_up_intents_provider_object"]
  }
}

Table "economy_funding_claims" {
  "SourceStampId" uuid [not null]
  "WalletId" uuid [not null]
  "Provider" "character varying(100)" [not null]
  "Environment" "character varying(50)" [not null]
  "ConnectedAccount" "character varying(256)" [not null]
  "ProviderObject" "character varying(256)" [not null]
  "ProviderMonetaryLeg" "character varying(256)" [not null]
  "AuthoritativeUsdMinorUnits" bigint [not null]
  "State" integer [not null]
  "ObservedAt" timestamp [not null]
  "ConfirmedAt" timestamp
  "StateChangedAt" timestamp [not null]
