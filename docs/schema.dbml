Table "CollectiveAttemptDraftChanges" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "SubmissionId" uuid [not null]
  "ActorId" uuid [not null]
  "PreviousVersion" bigint [not null]
  "NewVersion" bigint [not null]
  "IdempotencyKey" "character varying(200)" [not null]
  "RequestHash" character(64) [not null]
  "ResponseHash" character(64) [not null]
  "ChangedAt" timestamp [not null]

  Checks {
    `"RequestHash" ~ '^[0-9a-f]{64}$' AND "ResponseHash" ~ '^[0-9a-f]{64}$'` [name: 'CK_CollectiveAttemptDraftChanges_Hashes']
    `"PreviousVersion" >= 0 AND "NewVersion" = "PreviousVersion" + 1` [name: 'CK_CollectiveAttemptDraftChanges_Version']
  }

  Indexes {
    Id [pk, name: "PK_CollectiveAttemptDraftChanges"]
    (SubmissionId, ActorId, IdempotencyKey) [unique, name: "IX_CollectiveAttemptDraftChanges_SubmissionId_ActorId_Idempote~"]
    (SubmissionId, NewVersion) [unique, name: "IX_CollectiveAttemptDraftChanges_SubmissionId_NewVersion"]
