  "ActivatedAt" timestamp [not null]
  "ReleaseProposedBy" uuid
  "ReleaseProposalReauthenticationHash" "character varying(128)"
  "ReleaseProposedAt" timestamp
  "ReleasedAt" timestamp

  Checks {
    `"Epoch" > 0` [name: 'ck_economy_kill_switches_epoch']
    `("ReleaseProposedBy" IS NULL AND "ReleaseProposedAt" IS NULL AND "ReleaseProposalReauthenticationHash" IS NULL) OR ("ReleaseProposedBy" IS NOT NULL AND "ReleaseProposedAt" >= "ActivatedAt" AND length(btrim("ReleaseProposalReauthenticationHash")) > 0)` [name: 'ck_economy_kill_switches_release_proposal']
    `("IsActive" AND "ReleasedAt" IS NULL) OR (NOT "IsActive" AND "ReleasedAt" >= "ActivatedAt")` [name: 'ck_economy_kill_switches_state']
  }

  Indexes {
    Id [pk, name: "PK_economy_kill_switches"]
