# apps/web/.env.local.example
#
# When using docker-compose (repo root `pnpm dev`), the root .env is injected
# into the web container and this file is NOT needed.
#
# When running `pnpm --filter @game-guild/web run dev` directly (no
# docker-compose), Next.js loads env from this directory (`apps/web/`), NOT
# the repo root. Copy this file to `.env.local` and fill in real values:
#
#   cp apps/web/.env.local.example apps/web/.env.local
#
# .env.local is gitignored by default — never commit secrets.

# --- Auth ---
# Session encryption secret (min 32 chars). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret-at-least-32-characters

# --- Backend API ---
# The .NET API base URL. Default matches `dotnet run` default port.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Google OAuth (optional; enables Google Sign-In button + One Tap) ---
# 3-way equality REQUIRED: GOOGLE_CLIENT_ID == NEXT_PUBLIC_GOOGLE_CLIENT_ID
# == the OAuth__Google__ClientId used by the API. Mismatch → backend
# audience validation rejects all tokens. See repo root .env.example.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Cookie domain (optional; for cross-subdomain auth in local dev) ---
# Set to ".gameguild.localhost" if running across multiple subdomains.
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=false

# --- Public URLs (optional; used for absolute links + sitemap) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Tag Manager (optional; leave unset to keep the site GTM-free) ---
# GTM container id (e.g. GTM-XXXXXXX). When unset or blank the GTM loader is a
# complete no-op (nothing rendered, nothing loaded). When set, the container
# still only loads for users whose analytics-cookie consent
# (settings > privacy > "Analytics cookies") is ON. No real container id is
# committed to the repo — set it per deployment environment.
NEXT_PUBLIC_GTM_CONTAINER_ID=

# --- emception WASM ---
# Self-hosted emception WASM manifest. The payload (108MB) is copied from
# tools/emception/public/cdn by `sync:emception` (wired into prebuild/predev)
# into public/emception/ (gitignored, served at /emception/*). If self-hosting
# is skipped, dev fallback: https://cdn.jsdelivr.net/npm/emception/cdn/manifest.json
NEXT_PUBLIC_EMCEPTION_MANIFEST_URL=/emception/manifest.json