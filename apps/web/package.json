  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "predev": "pnpm run sync:emception",
    "build": "next build --webpack",
    "prebuild": "pnpm run build:emception-dependencies && pnpm run sync:emception",
    "build:emception-dependencies": "pnpm --dir ../../packages/infrastructure/client run build && pnpm run build:emception-runtime-dependencies",
    "build:emception-runtime-dependencies": "pnpm --dir ../../tools/emception/packages/core run build && pnpm --dir ../../tools/emception/packages/xterm run build && pnpm --dir ../../tools/emception/packages/browser run build && pnpm --dir ../../tools/emception/packages/ide run build",
    "sync:emception": "node scripts/sync-emception-cdn.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:economy:coverage": "vitest run -c vitest.economy.config.mts --coverage",
    "test:browser:economy": "node scripts/economy-browser-e2e.mjs",
    "test:browser:public": "node scripts/public-browser-smoke.mjs",
    "test:browser:block-editor": "node scripts/block-content-editor-browser-e2e.mjs",
    "test:browser:learning-checkout": "node scripts/learning-checkout-browser-e2e.mjs",
    "test:browser:learning-student": "node scripts/learning-student-browser-e2e.mjs",
    "test:browser:learning-professor": "node scripts/learning-professor-browser-e2e.mjs",
    "test:browser:learning-support": "node --test scripts/learning-browser-e2e-support.test.mjs",
    "test:browser:community-admin": "node scripts/community-admin-browser-e2e.mjs",
    "test:browser:user-settings": "node scripts/user-settings-browser-e2e.mjs",
    "test:browser:testing-lab": "node scripts/run-testing-lab-browser-e2e.mjs",
    "test:browser:testing-lab:existing": "node scripts/testing-lab-browser-e2e.mjs",
    "test:browser:coding-cycle": "node scripts/coding-cycle-browser-e2e.mjs",
    "test:watch": "vitest",
    "test:e2e": "vitest run -c vitest.e2e.config.mts",
    "test:browser:learning": "pnpm run test:browser:learning-support && pnpm run test:browser:learning-checkout && pnpm run test:browser:learning-student && pnpm run test:browser:learning-professor"
  },
