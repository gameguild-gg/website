<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>GameGuild.Learning.Assessments.Tests</RootNamespace>
    </PropertyGroup>

    <!-- Coverage Thresholds -->
    <PropertyGroup>
        <CollectCoverage>false</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <CoverletOutput>./TestResults/coverage.xml</CoverletOutput>
        <Threshold>100</Threshold>
        <ThresholdType>line,branch,method</ThresholdType>
        <ThresholdStat>total</ThresholdStat>
        <ExcludeByFile>**/*Tests.cs,**/obj/**,**/Migrations/**</ExcludeByFile>
        <ExcludeByAttribute>CompilerGenerated,GeneratedCodeAttribute</ExcludeByAttribute>
        <Include>[GameGuild.Learning.Assessments]*</Include>
    </PropertyGroup>
    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="coverlet.msbuild" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Assets\GameGuild.Assets.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Learning.Assessments\GameGuild.Learning.Assessments.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Learning.Assessments.QuizAdapter\GameGuild.Learning.Assessments.QuizAdapter.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.SharedKernel\GameGuild.SharedKernel.csproj" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="..\..\..\..\packages\features\grading-adapter-quiz\fixtures\quiz-answer-envelope-v1.json"
                          LogicalName="GameGuild.Grading.Fixtures.quiz-answer-envelope-v1.json" />
        <EmbeddedResource Include="..\..\..\..\packages\features\grading-adapter-quiz\fixtures\quiz-partial-credit-v1.json"
                          LogicalName="GameGuild.Grading.Fixtures.quiz-partial-credit-v1.json" />
        <EmbeddedResource Include="..\..\..\..\packages\features\grading-adapter-quiz\fixtures\quiz-validation-cases-v1.json"
                          LogicalName="GameGuild.Grading.Fixtures.quiz-validation-cases-v1.json" />
    </ItemGroup>
</Project>
