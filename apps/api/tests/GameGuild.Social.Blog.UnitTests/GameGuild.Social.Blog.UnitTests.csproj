<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>GameGuild.Social.Blog.UnitTests</RootNamespace>
    </PropertyGroup>
    <!-- Coverage Thresholds -->
    <PropertyGroup>
        <CollectCoverage>false</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <CoverletOutput>./TestResults/coverage.xml</CoverletOutput>
        <Threshold>20</Threshold>
        <ThresholdType>line,branch,method</ThresholdType>
        <ThresholdStat>total</ThresholdStat>
        <ExcludeByFile>**/*Tests.cs,**/obj/**,**/Migrations/**</ExcludeByFile>
        <ExcludeByAttribute>CompilerGenerated,GeneratedCodeAttribute</ExcludeByAttribute>
        <Include>[GameGuild.Social.Blog]*</Include>
    </PropertyGroup>
    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="coverlet.msbuild" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Social.Blog\GameGuild.Social.Blog.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.SharedKernel\GameGuild.SharedKernel.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Social.Profiles\GameGuild.Social.Profiles.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Social.Follows\GameGuild.Social.Follows.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Social.Reactions\GameGuild.Social.Reactions.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Identity.Context\GameGuild.Identity.Context.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Tags\GameGuild.Tags.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.AI\GameGuild.AI.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Finance.Economy.AiCredits\GameGuild.Finance.Economy.AiCredits.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Resources\GameGuild.Resources.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Assets\GameGuild.Assets.csproj" />
    </ItemGroup>
</Project>
