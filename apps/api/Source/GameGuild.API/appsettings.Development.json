{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuthenticationDb": "Host=localhost;Port=5432;Database=gameguild;Username=postgres;Password=postgres;Include Error Detail=true;Maximum Pool Size=100;Minimum Pool Size=5;Connection Idle Lifetime=300",
    "DefaultConnection": "Host=localhost;Port=5432;Database=gameguild;Username=postgres;Password=postgres;Include Error Detail=true;Maximum Pool Size=100;Minimum Pool Size=5;Connection Idle Lifetime=300"
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "GameGuild.API",
    "OtlpEndpoint": "http://localhost:14318",
    "OtlpProtocol": "http/protobuf",
    "ConsoleExporterEnabled": false,
    "IncludeSqlStatements": false
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "GameGuild:",
    "DefaultExpirationMinutes": 60,
    "FeatureFlagExpirationMinutes": 15,
    "UserSessionExpirationMinutes": 120,
    "EnableHealthChecks": true,
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000
  },
  "App": {
    "BaseUrl": "http://localhost:3000"
  },
  "PresentationLayer": {
    "EnableHttpLogging": true,
    "EnableProblemDetails": true,
    "EnableLocalization": true,
    "EnableMemoryCaching": true,
    "EnableResponseCaching": true,
    "EnableResponseCompression": true,
    "EnableCors": true,
    "EnableAuthentication": true,
    "EnableRequestContext": true,
    "EnableAuthorization": true,
    "EnableRateLimiting": false,
    "EnableModelValidation": true,
    "EnableFeatureFlags": true,
    "EnableApiVersioning": true,
    "EnableHealthChecks": true,
    "EnableSignalR": false,
    "EnableOpenApi": true,
    "EnableApiExplorer": true,
    "EnableGraphQl": false
  },
  "Authentication": {
    "EnableAuthentication": true,
    "EnableAuthorization": true,
    "EnableDacAuthorization": true,
    "JwtSecretKey": "development-secret-key-at-least-32-characters-long-for-local-testing",
    "JwtIssuer": "GameGuild",
    "JwtAudience": "GameGuild.Users",
    "JwtExpiration": "24:00:00"
  },
  "Assets": {
    "Storage": {
      "BucketName": "gameguild-assets",
      "TransformedBucketName": "gameguild-assets-transformed",
      "QuarantineBucketName": "gameguild-assets-quarantine",
      "ServiceUrl": "http://localhost:3900",
      "AccessKey": "GK111111111111111111111111",
      "SecretKey": "2222222222222222222222222222222222222222222222222222222222222222",
      "Region": "garage",
      "ForcePathStyle": true,
      "PresignedUrlExpiryMinutes": 60
    }
  },
  "EmailDelivery": {
    "Enabled": true,
    "FromEmail": "no-reply@gameguild.local",
    "FromName": "GameGuild",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SmtpUseSsl": false
  },
  "PaymentGateways": {
    "Stripe": {
      "IsEnabled": true,
      "UseSimulation": true
    }
  }
}
