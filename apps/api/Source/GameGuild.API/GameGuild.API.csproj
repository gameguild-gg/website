<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- No wwwroot/static assets in this API. Disables static web assets manifests so
             `dotnet watch` doesn't try to read obj/.../staticwebassets.development.json
             (SDK 10.0.3xx watch resolves that path with Windows separators on macOS and errors). -->
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
        <!-- Keep in lockstep with the monorepo release version; bumped by scripts/devops/auto-changeset.mjs (apply mode) -->
        <Version>4.3.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GameGuild.Commerce.Orders.IntegrationTests" />
        <InternalsVisibleTo Include="GameGuild.Commerce.Products.IntegrationTests" />
        <InternalsVisibleTo Include="GameGuild.Commerce.Payments.IntegrationTests" />
        <InternalsVisibleTo Include="GameGuild.Commerce.Subscriptions.IntegrationTests" />
        <InternalsVisibleTo Include="GameGuild.Commerce.Billing.IntegrationTests" />
        <InternalsVisibleTo Include="GameGuild.API.UnitTests" />
        <InternalsVisibleTo Include="GameGuild.API.IntegrationTests" />
        <ProjectReference Include="..\Modules\GameGuild.Announcements.Contracts\GameGuild.Announcements.Contracts.csproj" />
    <ProjectReference Include="..\Modules\GameGuild.Social.Announcements\GameGuild.Social.Announcements.csproj" />
  </ItemGroup>

    <ItemGroup>
        <!-- dotnet watch: editing a migration must NOT restart/hot-reload the API —
             EF migrations run at startup, so only a full manual restart applies them.
             (dotnet watch reads %(Compile.Watch) — <Watch Remove> would be a no-op.) -->
        <Compile Update="Database\Migrations\**" Watch="false" />
    </ItemGroup>

    <ItemGroup>
