{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuthenticationDb": "Host=postgres;Port=5432;Database=GameGuild;Username=postgres;Password=postgres;Include Error Detail=true;Maximum Pool Size=100;Minimum Pool Size=5;Connection Idle Lifetime=300",
    "DefaultConnection": "Host=postgres;Port=5432;Database=GameGuild;Username=postgres;Password=postgres;Include Error Detail=true;Maximum Pool Size=100;Minimum Pool Size=5;Connection Idle Lifetime=300"
  },
  "AllowedHosts": "*",
  "Identity": {
    "Invitations": {
      "ReviewPath": "/my/invitations"
    }
  },
  "Jwt": {
    "Issuer": "GameGuild",
    "Audience": "GameGuild.Users",
    "SecretKey": "CHANGE_THIS_TO_A_SECURE_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30,
    "ClockSkewSeconds": 0,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "Mfa": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15,
    "BackupCodesCount": 10,
    "BackupCodeLength": 8,
    "TotpTimeStepSeconds": 30,
    "TotpClockSkew": 1,
    "SetupSessionDurationMinutes": 10,
    "RequireMfaByDefault": false,
    "TotpIssuer": "GameGuild",
    "Enabled": true
  },
  "Session": {
    "IdleTimeoutMinutes": 30,
    "AbsoluteTimeoutMinutes": 1440,
    "MaxConcurrentSessions": 5,
    "TrustedDeviceDurationDays": 30,
    "MaxTrustedDevices": 10,
    "TerminateSessionsOnPasswordChange": true,
    "TerminateSessionsOnMfaDisable": true,
    "EnableDeviceFingerprinting": true,
    "EnableLocationTracking": true,
    "RequireTrustedDeviceForSensitiveOps": false
  },
  "AuthenticationSecurity": {
    "MaxFailedAttemptsPerHour": 5,
    "MaxFailedAttemptsPerDay": 20,
    "MaxAttemptsPerIpPerHour": 50,
    "AccountLockoutDurationMinutes": 30,
    "EnableIpThrottling": true,
    "EnableUserEnumerationProtection": true,
    "EnableAnomalyDetection": true,
    "RequireEmailVerification": true,
    "EmailVerificationTokenValidityHours": 24,
    "PasswordResetTokenValidityHours": 1,
    "EnableCaptchaOnSuspiciousActivity": false,
    "SuspiciousThreshold": 3
  },
  "Encryption": {
    "EncryptionKey": "CHANGE_THIS_TO_A_SECURE_256_BIT_ENCRYPTION_KEY_BASE64_OR_HEX",
    "Algorithm": "AES256",
    "CipherMode": "CBC",
    "PaddingMode": "PKCS7",
    "EnableKeyRotation": false,
    "KeyRotationIntervalDays": 90,
    "PreviousKeys": null
  },
  "UserEnumerationProtection": {
    "Enabled": true,
    "MinProcessingTimeMs": 200,
    "MaxProcessingTimeMs": 800,
    "TargetProcessingTimeMs": 400,
    "ConsistentErrorMessage": "Invalid credentials. Please check your email and password.",
    "EnableRandomJitter": true,
    "MaxJitterMs": 100
  },
  "AuthenticationAnomaly": {
    "Enabled": true,
    "MaxFailedAttemptsPerHour": 5,
    "MaxFailedAttemptsPerDay": 20,
    "SuspiciousThreshold": 3,
    "ThrottleDurationMinutes": 15,
    "MaxAttemptsPerIpPerHour": 50,
    "EnableLocationTracking": true,
    "FlagNewDevices": true,
    "FlagNewLocations": true,
    "EnableVelocityChecks": true,
    "MinTimeBetweenAttemptsSeconds": 5,
    "EnableBehavioralAnalysis": true
  },
  "PresentationLayer": {
    "EnableHttpLogging": false,
    "EnableProblemDetails": true,
    "EnableLocalization": false,
    "EnableMemoryCaching": true,
    "EnableResponseCaching": true,
    "EnableResponseCompression": true,
    "EnableCors": true,
    "EnableAuthentication": true,
    "EnableRequestContext": true,
    "EnableAuthorization": true,
    "EnableRateLimiting": true,
    "EnableModelValidation": true,
    "EnableFeatureFlags": false,
    "EnableApiVersioning": true,
    "EnableHealthChecks": true,
    "EnableSignalR": false,
    "EnableOpenApi": true,
    "EnableApiExplorer": true,
    "EnableGraphQl": false
  },
  "Authentication": {
