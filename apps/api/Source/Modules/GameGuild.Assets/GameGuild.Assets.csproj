<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>GameGuild.Assets</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="AWSSDK.S3" />
        <PackageReference Include="Magick.NET-Q8-AnyCPU" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(PkgMagick_NET-Q8-AnyCPU)/Notice.txt"
                 Link="third-party/Magick.NET-Notice.txt"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GameGuild.SharedKernel\GameGuild.SharedKernel.csproj" />
        <ProjectReference Include="..\GameGuild.Identity.Authorization\GameGuild.Identity.Authorization.csproj" />
        <ProjectReference Include="..\GameGuild.Identity.Context\GameGuild.Identity.Context.csproj" />
        <ProjectReference Include="..\GameGuild.Identity.Tenants\GameGuild.Identity.Tenants.csproj" />
        <ProjectReference Include="..\GameGuild.Resources\GameGuild.Resources.csproj" />
        <ProjectReference Include="..\GameGuild.Features\GameGuild.Features.csproj" />
        <ProjectReference Include="..\GameGuild.Localization\GameGuild.Localization.csproj" />
    </ItemGroup>

</Project>
