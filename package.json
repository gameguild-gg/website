{
  "name": "game-guild",
  "version": "0.1.0",
  "description": "GameGuild Platform Monorepo",
  "author": "Matheus Martins <contact@matheusmartins.com>",
  "homepage": "https://gameguild.gg",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "docker compose -f compose.yaml up -d --wait && run-p dev:web dev:api",
    "dev:api": "ASPNETCORE_ENVIRONMENT=Development dotnet run --project apps/api/Source/GameGuild.API/GameGuild.API.csproj --urls http://localhost:8080",
    "dev:compose": "docker compose -f compose.yaml --profile app up -d --build",
    "dev:compose:down": "docker compose -f compose.yaml down",
    "dev:compose:logs": "docker compose -f compose.yaml logs -f",
    "dev:compose:ps": "docker compose -f compose.yaml ps",
    "dev:compose:restart": "docker compose -f compose.yaml restart",
    "dev:compose:stop": "docker compose -f compose.yaml stop",
    "dev:learning": "pnpm --filter @game-guild/learning run dev",
    "dev:web": "pnpm --filter @game-guild/client build && pnpm --filter @game-guild/web run dev",
    "dev:emception": "pnpm --dir tools/emception/apps/ide-react run dev",
    "build": "turbo run build",
    "build:emception": "pnpm --dir tools/emception run build:packages",
    "build:learning": "pnpm --filter @game-guild/learning run build",
    "build:web": "pnpm --filter @game-guild/web run build",
    "test": "turbo run test",
    "test:emception": "pnpm --dir tools/emception run test:packages",
    "test:emception:e2e": "pnpm --dir tools/emception run e2e:smoke",
    "test:emception:e2e:full": "pnpm --dir tools/emception run e2e:react",
    "test:emception:types": "pnpm --dir tools/emception run test:types:packages",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "typecheck:emception": "pnpm --dir tools/emception run typecheck:packages",
    "lint": "turbo run lint",
    "format": "pnpm -r run format",
    "generate": "turbo run generate",
    "api:client:generate": "pnpm --filter @game-guild/client generate",
    "sync:format": "syncpack format",
    "sync:list": "syncpack list",
    "sync:lint": "syncpack lint",
    "sync:fix": "syncpack fix-mismatches",
    "smoke": "node scripts/devops/smoke-check.mjs",
    "smoke:live": "node scripts/devops/smoke-check.mjs --live",
    "test:smoke": "node --test scripts/devops/smoke-check.test.mjs",
    "ci:dependencies": "bash scripts/ci/install-and-audit-pnpm.sh",
    "ci:economy": "bash scripts/ci/verify-economy.sh",
    "ci:api:publish": "dotnet publish apps/api/Source/GameGuild.API/GameGuild.API.csproj -c Release --no-restore --nologo -o artifacts/test-results/publish/api",
    "ci:provider-contracts": "dotnet test apps/api/tests/GameGuild.Commerce.Billing.UnitTests/GameGuild.Commerce.Billing.UnitTests.csproj -c Release --no-restore --filter \"FullyQualifiedName~Stripe|FullyQualifiedName~Webhook\" && dotnet test apps/api/tests/GameGuild.Commerce.Payments.UnitTests/GameGuild.Commerce.Payments.UnitTests.csproj -c Release --no-restore --filter \"FullyQualifiedName~Stripe\"",
    "ci:web:build": "pnpm --filter @game-guild/web build",
    "ci:playwright:smoke": "pnpm --filter @game-guild/web test:browser:public",
    "ci:playwright:learning-student": "pnpm --filter @game-guild/web test:browser:learning-student",
    "clean": "rimraf --glob ./**/node_modules ./**/dist ./**/coverage ./**/build ./**/.next ./**/.turbo pnpm-lock.yaml",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": "7.29.7",
      "@tootallnate/once": "2.0.1",
      "@excalidraw/excalidraw>nanoid": "3.3.8",
      "@excalidraw/mermaid-to-excalidraw>nanoid": "5.0.9",
      "dompurify": "3.4.11",
      "lodash-es": "4.18.0",
      "syncpack>minimatch": "9.0.7",
      "icu-minify": "4.9.2",
      "next": "16.2.9",
      "postcss": "8.5.15",
      "prismjs": "1.30.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "tsup>esbuild": "0.28.1",
      "ws": "8.21.0"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@game-guild/eslint-config": "workspace:*",
    "@game-guild/prettier-config": "workspace:*",
    "@game-guild/typescript-config": "workspace:*",
    "eslint": "^9.18.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.0",
    "syncpack": "^13.0.4",
    "turbo": "^2.8.20",
    "typescript": "^5.8.3",
    "npm-run-all": "4.1.5"
  }
}
