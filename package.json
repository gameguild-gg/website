{
  "name": "game-guild",
  "version": "4.4.0",
  "description": "GameGuild Platform Monorepo",
  "author": "Matheus Martins <contact@matheusmartins.com>",
  "homepage": "https://gameguild.gg",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fast": "node scripts/dev-fast.mjs",
    "dev:api": "dotenv -e .env -v DOTNET_USE_POLLING_FILE_WATCHER=true -- dotnet watch --project apps/api/Source/GameGuild.API/GameGuild.API.csproj run --urls http://localhost:8080",
    "dev:compose": "docker compose -f compose.yaml --profile app up -d --build",
    "dev:compose:down": "docker compose -f compose.yaml down --remove-orphans",
    "dev:compose:logs": "docker compose -f compose.yaml logs -f",
    "dev:compose:ps": "docker compose -f compose.yaml ps",
    "dev:compose:restart": "docker compose -f compose.yaml restart",
    "dev:compose:stop": "docker compose -f compose.yaml stop",
    "dev:web": "corepack pnpm --filter @game-guild/client build && corepack pnpm --filter @game-guild/web run dev",
    "kill:ports": "node scripts/dev-stop.mjs --skip-compose",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:repair": "pnpm run dev:stop && pnpm run clean:generated",
    "dev:reset:data": "pnpm run kill:ports && docker compose -f compose.yaml down --remove-orphans --volumes && pnpm run clean:generated",
    "dev:emception": "pnpm --dir demos/emception-ide-react run dev",
    "build": "turbo run build",
    "build:emception": "pnpm --dir tools/emception run build:packages",
    "build:web": "pnpm --filter @game-guild/web run build",
    "test": "turbo run test",
    "test:emception": "pnpm --dir tools/emception run test:packages",
    "test:emception:e2e": "pnpm --dir tools/emception run e2e --project=chromium",
    "test:emception:e2e:full": "pnpm --dir tools/emception run e2e:react",
    "test:emception:types": "pnpm --dir tools/emception run test:types:packages",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "e2e": "playwright test",
    "grading:scenario": "node apps/web/scripts/quiz-grading-scenario/cli.mjs",
    "e2e:record": "node scripts/e2e-record.mjs",
    "e2e:record:continue": "node scripts/e2e-record-continue.mjs",
    "typecheck": "turbo run typecheck",
    "typecheck:emception": "pnpm --dir tools/emception run typecheck:packages",
    "version:emception": "node scripts/devops/version-emception.mjs",
    "publish:emception": "node scripts/devops/publish-emception.mjs",
    "lint": "turbo run lint",
    "format": "pnpm -r run format",
    "generate": "turbo run generate",
    "api:client:generate": "pnpm --filter @game-guild/client generate && pnpm --filter @game-guild/client build",
    "sync:format": "syncpack format",
    "sync:list": "syncpack list",
    "sync:lint": "syncpack lint",
    "sync:fix": "syncpack fix",
    "smoke": "node scripts/devops/smoke-check.mjs",
    "smoke:live": "node scripts/devops/smoke-check.mjs --live",
    "test:smoke": "node --test scripts/devops/smoke-check.test.mjs",
    "db:dbml": "node scripts/devops/generate-dbml.mjs",
    "db:dbml:check": "node scripts/devops/generate-dbml.mjs --check",
    "db:dbml:verify": "node scripts/devops/generate-dbml.mjs --verify-db",
    "ci:dependencies": "bash scripts/ci/install-and-audit-pnpm.sh",
    "ci:repository-policy": "bash scripts/ci/verify-repository-policy.sh",
    "ci:economy": "bash scripts/ci/verify-economy.sh",
    "ci:api:publish": "dotnet publish apps/api/Source/GameGuild.API/GameGuild.API.csproj -c Release --no-restore --nologo -o artifacts/test-results/publish/api",
    "ci:provider-contracts": "dotnet test apps/api/tests/GameGuild.Commerce.Billing.UnitTests/GameGuild.Commerce.Billing.UnitTests.csproj -c Release --no-restore --filter \"FullyQualifiedName~Stripe|FullyQualifiedName~Webhook\" && dotnet test apps/api/tests/GameGuild.Commerce.Payments.UnitTests/GameGuild.Commerce.Payments.UnitTests.csproj -c Release --no-restore --filter \"FullyQualifiedName~Stripe\"",
    "ci:web:build": "pnpm --filter @game-guild/web build",
    "ci:playwright:smoke": "pnpm --filter @game-guild/web test:browser:public",
    "ci:playwright:learning-student": "pnpm --filter @game-guild/web test:browser:learning-student",
    "clean:generated": "rimraf --glob ./.turbo ./apps/web/.next ./apps/web/.next-fast ./apps/web/.turbo \"./apps/web/*.tsbuildinfo\" ./packages/infrastructure/client/dist ./packages/infrastructure/client/dist-fast ./packages/infrastructure/client/.turbo \"./apps/api/**/bin\" \"./apps/api/**/obj\"",
    "clean": "rimraf --glob ./**/node_modules ./**/dist ./**/dist-fast ./**/coverage ./**/build ./**/.next ./**/.turbo"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.34.6 <11"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@dbml/cli": "^10.2.0",
    "@dbml/core": "^10.2.0",
    "@game-guild/eslint-config": "workspace:*",
    "@game-guild/prettier-config": "workspace:*",
    "@game-guild/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "npm-run-all": "4.1.5",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "rimraf": "^6.0.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
