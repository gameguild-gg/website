{
  "version": "4.3.0",
  "name": "@gameguild/emception-react",
  "description": "React 19 components for emception: <EmceptionRun>, <EmceptionTerminal>, <EmceptionCanvas>, useEmception().",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gameguild-gg/gameguild.git",
    "directory": "tools/emception/packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');for(const path of ['dist','tsconfig.tsbuildinfo'])fs.rmSync(path,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@gameguild/emception-browser": "4.3.0",
    "emception": "4.3.0"
  },
  "peerDependencies": {
    "@gameguild/emception-xterm": "^4.3.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@gameguild/emception-xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^6.0.3"
  }
}
