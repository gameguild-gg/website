{
  "version": "4.3.0",
  "name": "@gameguild/emception-webcomponent",
  "description": "<emception-run> custom element. No framework deps.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gameguild-gg/gameguild.git",
    "directory": "tools/emception/packages/webcomponent"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node ../../scripts/run-node-tests.mjs tests",
    "clean": "node -e \"const fs=require('fs');for(const path of ['dist','tsconfig.tsbuildinfo'])fs.rmSync(path,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@gameguild/emception-browser": "4.3.0",
    "emception": "4.3.0"
  },
  "peerDependencies": {
    "@gameguild/emception-xterm": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@gameguild/emception-xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
