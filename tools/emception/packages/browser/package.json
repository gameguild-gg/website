{
  "version": "4.3.0",
  "name": "@gameguild/emception-browser",
  "description": "Browser runtime adapter for emception: Web Worker spawn, IDB workspace store, OffscreenCanvas helpers, COI preflight.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./coi": {
      "import": "./dist/coi/index.js",
      "types": "./dist/coi/index.d.ts"
    },
    "./coi-serviceworker.js": "./dist/coi-serviceworker.js",
    "./worker": {
      "import": "./dist/worker-entry.js",
      "types": "./dist/worker-entry.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gameguild-gg/gameguild.git",
    "directory": "tools/emception/packages/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:manifest-url": "node ../../scripts/generate-browser-manifest-url.mjs",
    "prebuild": "pnpm run generate:manifest-url",
    "build": "pnpm run clean && tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.copyFileSync('src/emscripten/subprocess_shim.py','dist/emscripten/subprocess_shim.py');fs.copyFileSync('../../public/coi-serviceworker.js','dist/coi-serviceworker.js')\"",
    "pretypecheck": "pnpm run generate:manifest-url",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node ../../scripts/run-node-tests.mjs tests",
    "clean": "node -e \"const fs=require('fs');for(const path of ['dist','tsconfig.tsbuildinfo'])fs.rmSync(path,{recursive:true,force:true})\""
  },
  "dependencies": {
    "emception": "4.3.0",
    "@gameguild/emception-xterm": "4.3.0"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@xterm/xterm": "^6.0.0",
    "typescript": "^6.0.3"
  }
}
