{
  "version": "4.3.0",
  "name": "emception-workspace",
  "private": true,
  "description": "Emscripten C/C++ toolchain running in the browser via WebAssembly",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "emception": "./bin/emception.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker-entry.js",
      "types": "./dist/worker-entry.d.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "public/cdn",
    "README.md",
    "LICENSE*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gameguild-gg/gameguild.git",
    "directory": "tools/emception"
  },
  "scripts": {
    "build:lib": "tsup && tsc -p tsconfig.lib.json",
    "prepublishOnly": "pnpm run build:lib",
    "stage:core:cdn": "pnpm toolchain build release",
    "stage:toolchain:cdn": "pnpm toolchain build release",
    "verify:release": "node scripts/verify-release.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "tsx scripts/clean.ts",
    "toolchain": "tsx scripts/toolchain/cli.ts",
    "recipe:emsdk": "tsx scripts/setup-emsdk.ts",
    "recipe:emscripten:warmup": "tsx scripts/warmup-emscripten-cache.ts",
    "recipe:binaryen": "tsx scripts/build-binaryen.ts",
    "recipe:cpython": "tsx scripts/build-cpython.ts",
    "recipe:llvm": "tsx scripts/build-llvm.ts",
    "recipe:libcurl-lite": "tsx scripts/build-libcurl-lite.ts",
    "recipe:cmake": "tsx scripts/build-cmake.ts",
    "recipe:sdl3": "tsx scripts/build-sdl3.ts",
    "recipe:imgui": "tsx scripts/build-imgui.ts",
    "recipe:raylib": "tsx scripts/build-raylib.ts",
    "recipe:allegro": "tsx scripts/build-allegro.ts",
    "recipe:sysroot": "tsx scripts/populate-sysroot.ts",
    "recipe:stage:sysroot": "node scripts/stage-sysroot.mjs",
    "recipe:manifest": "tsx scripts/generate-manifest.ts",
    "recipe:brotli": "tsx scripts/build-brotli.ts",
    "recipe:bundles": "tsx scripts/generate-bundles.ts",
    "recipe:assert-no-dupes": "tsx scripts/assert-no-duplicate-hashes.ts",
    "recipe:patch:glue": "tsx scripts/patch-glue.ts",
    "recipe:deploy:cdn": "tsx scripts/deploy-cdn.ts",
    "recipe:stage:toolchain:cdn": "node scripts/stage-toolchain-cdn.mjs",
    "recipe:stage:core:cdn": "node scripts/stage-core-cdn.mjs",
    "build:emsdk": "pnpm toolchain build emsdk",
    "build:emscripten:warmup": "pnpm toolchain build warmup",
    "build:binaryen": "pnpm toolchain build binaryen",
    "build:cpython": "pnpm toolchain build python",
    "build:llvm": "pnpm toolchain build llvm",
    "build:libcurl-lite": "pnpm toolchain build curlLite",
    "build:cmake": "pnpm toolchain build cmake",
    "build:sdl3": "pnpm toolchain build sdl3",
    "build:imgui": "pnpm toolchain build imgui",
    "build:raylib": "pnpm toolchain build raylib",
    "build:allegro": "pnpm toolchain build allegro",
    "build:sysroot": "pnpm toolchain build sysroot",
    "build:stage:sysroot": "pnpm toolchain build stage",
    "build:manifest": "pnpm toolchain build manifest",
    "build:brotli": "pnpm toolchain build brotli",
    "build:bundles": "pnpm toolchain build bundles",
    "build:assert-no-dupes": "pnpm toolchain build assert",
    "patch:glue": "pnpm toolchain build glue",
    "deploy:cdn": "pnpm toolchain build release",
    "build:toolchain:light": "pnpm toolchain build light",
    "build:toolchain:heavy": "pnpm toolchain build heavy",
    "build:toolchain:parallel": "pnpm toolchain build toolchain",
    "build:graphics:parallel": "pnpm toolchain build graphics",
    "build:graphics": "pnpm toolchain build graphics",
    "build:cdn:serial": "pnpm toolchain release",
    "build:all": "run-s build:packages && pnpm toolchain build all && pnpm toolchain release",
    "build:cdn": "pnpm toolchain release",
    "build:pipeline": "pnpm toolchain release",
    "build:packages": "run-s build:packages:core build:packages:xterm build:packages:browser build:packages:react build:packages:webcomponent build:packages:ide",
    "build:packages:core": "pnpm --filter emception run build",
    "build:packages:browser": "pnpm --filter @gameguild/emception-browser run build",
    "build:packages:xterm": "pnpm --filter @gameguild/emception-xterm run build",
    "build:packages:react": "pnpm --filter @gameguild/emception-react run build",
    "build:packages:webcomponent": "pnpm --filter @gameguild/emception-webcomponent run build",
    "build:packages:ide": "pnpm --filter @gameguild/emception-ide run build",
    "test:scripts": "node scripts/run-node-tests.mjs scripts/tests",
    "test:packages": "run-s test:scripts test:packages:core test:packages:xterm test:packages:browser test:packages:webcomponent test:packages:ide",
    "test:packages:core": "pnpm --filter emception test",
    "test:packages:xterm": "pnpm --filter @gameguild/emception-xterm run build",
    "test:packages:browser": "pnpm --filter @gameguild/emception-browser test",
    "test:types:packages": "pnpm --filter emception run test:types",
    "test:packages:webcomponent": "pnpm --filter @gameguild/emception-webcomponent test",
    "test:packages:ide": "pnpm --filter @gameguild/emception-ide test",
    "typecheck:packages": "run-s typecheck:packages:core typecheck:packages:browser typecheck:packages:xterm typecheck:packages:react typecheck:packages:webcomponent typecheck:packages:ide",
    "typecheck:packages:core": "pnpm --filter emception run typecheck",
    "typecheck:packages:browser": "pnpm --filter @gameguild/emception-browser run typecheck",
    "typecheck:packages:xterm": "pnpm --filter @gameguild/emception-xterm run typecheck",
    "typecheck:packages:react": "pnpm --filter @gameguild/emception-react run typecheck",
    "typecheck:packages:webcomponent": "pnpm --filter @gameguild/emception-webcomponent run typecheck",
    "typecheck:packages:ide": "pnpm --filter @gameguild/emception-ide run typecheck",
    "clean:packages": "run-s clean:packages:*",
    "clean:packages:core": "pnpm --filter emception run clean",
    "clean:packages:browser": "pnpm --filter @gameguild/emception-browser run clean",
    "clean:packages:xterm": "pnpm --filter @gameguild/emception-xterm run clean",
    "clean:packages:react": "pnpm --filter @gameguild/emception-react run clean",
    "clean:packages:webcomponent": "pnpm --filter @gameguild/emception-webcomponent run clean",
    "clean:packages:ide": "pnpm --filter @gameguild/emception-ide run clean",
    "e2e": "npx playwright test --config=playwright.config.ts",
    "e2e:react": "npx playwright test --config=playwright.config.react.ts"
  },
  "dependencies": {
    "@gameguild/emception-browser": "workspace:*",
    "@gameguild/emception-xterm": "workspace:*"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@xterm/xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20",
    "@types/shelljs": "^0.10.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/xterm": "^6.0.0",
    "cli-progress": "^3.12.0",
    "npm-run-all": "4.1.5",
    "shelljs": "^0.10.0",
    "tar": "^7.5.22",
    "tsd": "^0.33.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.1"
  }
}
