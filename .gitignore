# Repository-wide ignore rules

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
nul

# Editors and IDEs
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/

# Cache and temp files
.cache/
.temp/
.tmp/

# Package manager state
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json
yarn.lock
.pnpm-store/

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Generic build and test output
build/
dist/
coverage/
test-results/
playwright-report/
playwright-report-react/
artifacts/
cov.json
cov[0-9]*.json
coverage.*.xml
coverage.*.json
apps/api/*temp-test-output.txt
apps/api/*test-failures-detail.txt
apps/api/build_output.txt
packages/infrastructure/client/temp_spec.json
touched_files_game_guild.txt
*.tsbuildinfo
apps/web/test-results/

# .NET
/bin/
/obj/
*.user
*.suo
*.cache
*.docstates
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
x64/
x86/
*.exe
*.dll
*.pdb
/[Tt]estResults/
/[Ll]ogs/

# Next.js
next-env.d.ts
.next/
/out/

# Vercel
.vercel

# Turbo
.turbo

# Generated repository visualizations
contributors/gource.txt
contributors/gource.mp4
contributors/gource.gif
**/gource.txt
**/gource.mp4

# Public assets generated at build time
public/pyodide/*
public/wasm/*
tools/emception/public/cdn/
tools/emception/public/c2w-net-proxy.wasm
tools/emception/bin/
tools/emception/logs/
*.wasm
*.wasm.gz
*.tar
*.tar.gz
*.zip
*.mp4
*.trx
*.bak
*.backup
*.old
*.ps1
*.psm1

# AI conversation dumps must not be versioned
docs/devlog/2025-08-10-permissions-refactor-conversation-summary.md

# Embedded upstream repos (avoid nested .git metadata/tooling conflicts)

# Miscellaneous
*.pem
.superpowers/
.worktrees/

# Security: infra/ contains secrets (CF tokens, origin certs, kubeconfig, ansible vault)
# Repo is PUBLIC — infra must NEVER be tracked
infra/
.omo/
