# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
csharp_prefer_braces = true:warning

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.{css,scss}]
indent_size = 2

[*.html]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

# SonarAnalyzer.CSharp staged severities (todo 10, codacy-quality-debt plan).
# Derived from .omo/codacy/csharp-patterns.json (all 131 Codacy patterns; the 45 SonarCSharp
# ones listed here). Staging: security + errorprone-real rules warn (build gate), every
# style/noise rule with findings is silenced until its owning batch fixes the debt.
# AnalysisMode stays AllDisabledByDefault (apps/api/Directory.Build.props) — Sonar analyzers
# still respect .editorconfig severities; disabled-by-default NET analyzers are unaffected.
[*.cs]
# --- Security (warning) ---
# NOTE: SonarSource hotspot rules (S2068, S5443, S5332, S2053, S2245) are DORMANT when
# SonarAnalyzer.CSharp runs standalone via PackageReference — they only fire under the
# SonarQube/SonarCloud Scanner. Severity=warning is set so they gate the build the moment
# a Scanner run activates them. Verified empirically (todo 10): scratch S2068 strings do
# not fire locally; rule + message strings confirmed present in the analyzer DLL.
# S2077 (SQLi) and S4784-4787 do not exist in SonarAnalyzer.CSharp 10.4 — SQLi is covered
# by Semgrep engine on the Codacy side.
dotnet_diagnostic.S2068.severity = warning   # hardcoded credentials (hotspot)
dotnet_diagnostic.S5332.severity = warning   # insecure URLs (http/telnet/ftp) (hotspot)
dotnet_diagnostic.S5443.severity = warning   # publicly writable directories (hotspot)
dotnet_diagnostic.S2053.severity = warning   # weak password hashing (hotspot)
dotnet_diagnostic.S2245.severity = warning   # weak randomness (hotspot)
# --- ErrorProne-real (warning) ---
dotnet_diagnostic.S2259.severity = warning   # null dereference
dotnet_diagnostic.S2589.severity = warning   # always-true/false condition
dotnet_diagnostic.S2583.severity = warning   # dead branch
dotnet_diagnostic.S3358.severity = none      # nested ternary — errorprone-real per plan but
                                             # 274 existing findings; parked like style debt
                                             # until its batch clears them, then escalate to warning# --- Style/noise from the Codacy inventory (none until fixed by owning batch) ---
dotnet_diagnostic.S2360.severity = none      # 5952: checkstyle-format
dotnet_diagnostic.S121.severity = none       # 5896: control-flow braces
dotnet_diagnostic.S1172.severity = none      # 922: unused parameters
dotnet_diagnostic.S2339.severity = none      # 699: public member mislabeled
dotnet_diagnostic.S1313.severity = none      # 167: tracked in Codacy; format noise
