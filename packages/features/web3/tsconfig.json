{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tooling/typescript/react.library.tsconfig.json",
  "display": "Web3",
  "compilerOptions": {
    "paths": {
      "@game-guild/web3": [
        "./src/index.ts"
      ],
      "@game-guild/web3/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
