{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@game-guild/typescript-config",
  "display": "Grading",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "paths": {
      "@game-guild/grading": ["./src/index.ts"],
      "@game-guild/grading/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
