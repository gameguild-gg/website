{
  "name": "@game-guild/block-content-editor",
  "version": "4.3.0",
  "type": "module",
  "description": "Reusable block content editor components and helpers for GameGuild apps",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./docs/*": "./src/docs/*",
    "./embed/*": "./src/embed/*",
    "./engines/*": "./src/engines/*",
    "./extras/*": "./src/extras/*",
    "./hooks/*": "./src/hooks/*",
    "./lib/*": "./src/lib/*",
    "./nodes/*": "./src/nodes/*",
    "./plugins/*": "./src/plugins/*",
    "./services/*": "./src/services/*",
    "./utils/*": "./src/utils/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@game-guild/ui": "workspace:^",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@game-guild/eslint-config": "workspace:*",
    "@game-guild/prettier-config": "workspace:*",
    "@game-guild/typescript-config": "workspace:*",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6.0.3"
  }
}
