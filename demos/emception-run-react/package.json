{
  "name": "@gameguild/emception-demo-run-react",
  "version": "4.3.0",
  "private": true,
  "description": "Minimal Vite + React 19 demo for the <EmceptionRun /> declarative wrapper from @gameguild/emception-react.",
  "type": "module",
  "scripts": {
    "predev": "npm run build:lib --prefix ../../tools/emception && node ../../tools/emception/scripts/install-app-cdn-from-package.mjs ../../demos/emception-run-react",
    "dev": "run-p watch:core watch:browser watch:react watch:webcomponent vite",
    "vite": "vite",
    "watch:core": "tsc -p ../../tools/emception/packages/core/tsconfig.json --watch --preserveWatchOutput",
    "watch:browser": "tsc -p ../../tools/emception/packages/browser/tsconfig.json --watch --preserveWatchOutput",
    "watch:react": "tsc -p ../../tools/emception/packages/react/tsconfig.json --watch --preserveWatchOutput",
    "watch:webcomponent": "tsc -p ../../tools/emception/packages/webcomponent/tsconfig.json --watch --preserveWatchOutput",
    "prebuild": "npm run build:lib --prefix ../../tools/emception && node ../../tools/emception/scripts/install-app-cdn-from-package.mjs ../../demos/emception-run-react",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gameguild/emception-browser": "4.3.0",
    "@gameguild/emception-react": "4.3.0",
    "@gameguild/emception-webcomponent": "4.3.0",
    "emception": "4.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.8.3",
    "vite": "^8.2.1"
  }
}
