{
    "name": "@gameguild/emception-demo-react",
    "version": "4.4.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node ../../tools/emception/scripts/ensure-emception-libs.mjs && node ../../tools/emception/scripts/install-app-cdn-from-package.mjs ../../demos/emception-ide-react",
        "dev": "run-p watch:core watch:browser watch:ide vite",
        "vite": "vite",
        "watch:core": "tsc -p ../../tools/emception/packages/core/tsconfig.json --watch --preserveWatchOutput",
        "watch:browser": "tsc -p ../../tools/emception/packages/browser/tsconfig.json --watch --preserveWatchOutput",
        "watch:ide": "tsc -p ../../tools/emception/packages/ide/tsconfig.json --watch --preserveWatchOutput",
        "prebuild": "node ../../tools/emception/scripts/ensure-emception-libs.mjs && node ../../tools/emception/scripts/install-app-cdn-from-package.mjs ../../demos/emception-ide-react",
        "build": "tsc -b && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@gameguild/emception-ide": "4.4.0",
        "@monaco-editor/react": "^4.7.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "emception": "4.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-resizable-panels": "^4.14.2"
    },
    "devDependencies": {
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.2",
        "typescript": "^6.0.3",
        "vite": "^8.3.2"
    }
}
